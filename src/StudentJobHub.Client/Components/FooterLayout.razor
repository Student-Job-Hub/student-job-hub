@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject AuthService AuthService
@inject IJSRuntime JS
@using MudBlazor

@* 
// a Footer component for the StudentJobHub application
// showing privacy and terms of service and also company's name and date of creation
*@

@code {
    private string companyName = "OptiTech Solutions";
    private string dateOfCreation = "2026";

    // navigate to terms and conditions page
    private void NavigateToTermsOfService()
    {
        NavigationManager.NavigateTo("/terms-of-services");
    }
    
    // navigate to privacy policy page
    private void NavigateToPrivacyPolicy()
    {
        NavigationManager.NavigateTo("/privacy-policy");
    }

    // navigate to contact page
    private void NavigateToContactPage()
    {
        NavigationManager.NavigateTo("/contact");
    }

}

<footer>
    <div class="container">
        <div class="row">
            <div class="col-12 text-center">
                <p>&copy; @dateOfCreation @companyName. All rights reserved.</p>
            </div>
        </div>
        <div class="row">
            <div class="col-12 text-center">
                <p class="footer-link">
                    <a href="/privacy-policy">Privacy Policy</a> | 
                    <a href="/terms-of-services">Terms of Service</a>
                </p>
            </div>
        </div>
        <div class="row">
            <div class="col-12 text-center">
                <p class="footer-link">
                    <a href="mailto:info@studjob.com">Contact Us</a>
                </p>
            </div>
        </div>
    </div>
</footer>

<style>
    footer {
        background-color: #f5f5f5;
        padding: 20px;
        margin-top: 50px;
    }

    footer p {
        margin: 0;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .row {
        margin-bottom: 10px;
    }

    .col-12 {
        margin-bottom: 10px;
        
    }
    
    .footer-link a {
        color: #2563eb;
        font-size: 14px;
        transition: color 0.5s ease-in-out;
        text-decoration: underline;
    }
   

    
    .text-center {
        text-align: center;
    }

    .row:last-child {
        margin-bottom: 0;
    }

    .row:first-child {
        margin-top: 0;
}

</style>