@code {
    [Parameter]
    public string TargetUserId { get; set; } = string.Empty;

    [Parameter]
    public string TargetUserName { get; set; } = string.Empty;

    [Parameter]
    public string ContextTitle { get; set; } = string.Empty;

    private List<ReviewModel> reviews = new();
    private ReviewSummaryModel summary = new();
    private CreateReviewModel newReview = new();
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showReviewModal = false;
    private string? errorMessage;
    private string? submissionError;
    private string? currentUserId;

    private bool isSelf => !string.IsNullOrEmpty(currentUserId) && currentUserId == TargetUserId;
    private bool hasAlreadyReviewed => !string.IsNullOrEmpty(currentUserId) && reviews.Any(r => r.ReviewerId == currentUserId);
    private bool CanLeaveReview => AuthService.IsLoggedIn && !isSelf && !hasAlreadyReviewed && !string.IsNullOrEmpty(TargetUserId);

    protected override async Task OnParametersSetAsync()
    {
        currentUserId = AuthService.User?.Id;
        if (!string.IsNullOrWhiteSpace(TargetUserId))
        {
            await LoadReviewsAsync();
        }
    }

    public async Task LoadReviewsAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            reviews = await ReviewApiService.GetUserReviewsAsync(TargetUserId);
            summary = ReviewSummaryModel.FromReviews(reviews);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load reviews: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private int GetStarCount(int stars)
    {
        return stars switch
        {
            5 => summary.Star5Count,
            4 => summary.Star4Count,
            3 => summary.Star3Count,
            2 => summary.Star2Count,
            1 => summary.Star1Count,
            _ => 0
        };
    }

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "U";
        var parts = name.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return $"{parts[0][0]}{parts[^1][0]}".ToUpper();
        return name.Length >= 2 ? name.Substring(0, 2).ToUpper() : name.ToUpper();
    }

    private void OpenReviewModal()
    {
        newReview = new CreateReviewModel
        {
            RevieweeId = TargetUserId,
            Rating = 5,
            Comment = ""
        };
        submissionError = null;
        showReviewModal = true;
    }

    private void CloseReviewModal()
    {
        showReviewModal = false;
        submissionError = null;
    }

    private async Task SubmitReviewAsync()
    {
        if (string.IsNullOrWhiteSpace(newReview.Comment))
        {
            submissionError = "Please enter a comment.";
            return;
        }

        isSubmitting = true;
        submissionError = null;
        newReview.RevieweeId = TargetUserId;

        try
        {
            var response = await ReviewApiService.CreateAsync(newReview);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("Review submitted successfully!");
                CloseReviewModal();
                await LoadReviewsAsync();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                submissionError = !string.IsNullOrWhiteSpace(body) ? body : "Failed to submit review.";
                ToastService.ShowError(submissionError);
            }
        }
        catch (Exception ex)
        {
            submissionError = $"Error: {ex.Message}";
            ToastService.ShowError(submissionError);
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteReviewAsync(int reviewId)
    {
        try
        {
            var response = await ReviewApiService.DeleteAsync(reviewId);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowInfo("Your review has been removed.");
                await LoadReviewsAsync();
            }
            else
            {
                ToastService.ShowError("Could not delete review.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error deleting review: {ex.Message}");
        }
    }
}
