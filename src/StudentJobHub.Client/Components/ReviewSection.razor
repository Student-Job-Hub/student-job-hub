@namespace StudentJobHub.Client.Components
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ReviewApiService ReviewApiService
@inject AuthService AuthService
@inject ToastService ToastService
@inject NavigationManager Navigation

<div class="review-section-wrapper">
    <div class="review-section-header">
        <div class="header-left">
            <h3 class="section-title">
                <i class="bi bi-star-fill text-warning me-2"></i>Reviews & Ratings
            </h3>
            @if (!string.IsNullOrEmpty(TargetUserName))
            {
                <p class="section-subtitle">Feedback for <strong>@TargetUserName</strong> @(!string.IsNullOrEmpty(ContextTitle) ? $"({ContextTitle})" : "")</p>
            }
        </div>

        @if (CanLeaveReview)
        {
            <button type="button" class="btn btn-primary btn-sm review-cta-btn" @onclick="OpenReviewModal">
                <i class="bi bi-pencil-square me-1"></i>Write a Review
            </button>
        }
    </div>

    @if (isLoading)
    {
        <div class="review-loading">
            <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
            <span class="ms-2">Loading reviews...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else
    {
        <!-- Rating Summary Card -->
        <div class="rating-summary-card">
            <div class="summary-score-box">
                <div class="big-score">@(summary.AverageRating > 0 ? summary.AverageRating.ToString("0.0") : "0.0")</div>
                <StarRating Rating="summary.AverageRating" IsReadOnly="true" Size="md" ShowScore="false" ShowCount="false" />
                <div class="total-reviews-count">@summary.TotalReviews @(summary.TotalReviews == 1 ? "review" : "reviews")</div>
            </div>

            <div class="summary-breakdown">
                @for (int stars = 5; stars >= 1; stars--)
                {
                    var count = GetStarCount(stars);
                    var percentage = summary.TotalReviews > 0 ? (count * 100.0 / summary.TotalReviews) : 0;

                    <div class="breakdown-row">
                        <span class="star-label">@stars <i class="bi bi-star-fill text-warning"></i></span>
                        <div class="progress-bar-track">
                            <div class="progress-bar-fill" style="width: @percentage%"></div>
                        </div>
                        <span class="count-label">@count</span>
                    </div>
                }
            </div>
        </div>

        <!-- Review Action Bar if not logged in or is self -->
        @if (!AuthService.IsLoggedIn)
        {
            <div class="login-prompt-bar">
                <span>Want to leave a review?</span>
                <a href="/login?returnUrl=@Navigation.Uri" class="btn btn-outline-primary btn-sm">Log In</a>
            </div>
        }
        else if (isSelf)
        {
            <div class="self-note">
                <i class="bi bi-info-circle me-1"></i> You cannot review your own profile or postings.
            </div>
        }
        else if (hasAlreadyReviewed)
        {
            <div class="reviewed-badge">
                <i class="bi bi-check-circle-fill text-success me-1"></i> You have already reviewed this user.
            </div>
        }

        <!-- Reviews List -->
        @if (reviews.Count == 0)
        {
            <div class="empty-reviews">
                <i class="bi bi-chat-square-heart empty-icon"></i>
                <h5>No reviews yet</h5>
                <p>Be the first to share feedback and rate your experience!</p>
            </div>
        }
        else
        {
            <div class="reviews-feed">
                @foreach (var review in reviews)
                {
                    <div class="review-item-card">
                        <div class="review-item-header">
                            <div class="reviewer-meta">
                                <div class="reviewer-avatar">@GetInitials(review.ReviewerName)</div>
                                <div>
                                    <div class="reviewer-name">@review.ReviewerName</div>
                                    <div class="review-date">@review.CreatedAt.ToString("MMM dd, yyyy")</div>
                                </div>
                            </div>

                            <div class="review-header-right">
                                <StarRating Rating="review.Rating" IsReadOnly="true" Size="sm" ShowScore="true" ShowCount="false" />
                                
                                @if (AuthService.IsLoggedIn && review.ReviewerId == currentUserId)
                                {
                                    <button type="button" class="btn btn-outline-danger btn-xs ms-2 delete-review-btn" 
                                            @onclick="() => DeleteReviewAsync(review.Id)"
                                            title="Delete your review">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="review-body">
                            <p class="review-comment">@review.Comment</p>
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

<!-- Write Review Modal -->
@if (showReviewModal)
{
    <div class="modal-backdrop-custom" @onclick="CloseReviewModal">
        <div class="modal-dialog-custom" @onclick:stopPropagation="true">
            <div class="modal-header-custom">
                <h4 class="modal-title">
                    <i class="bi bi-star-half text-warning me-2"></i>Rate & Review @TargetUserName
                </h4>
                <button type="button" class="btn-close-custom" @onclick="CloseReviewModal">&times;</button>
            </div>

            <EditForm Model="@newReview" OnValidSubmit="SubmitReviewAsync">
                <DataAnnotationsValidator />

                <div class="modal-body-custom">
                    @if (!string.IsNullOrEmpty(submissionError))
                    {
                        <div class="alert alert-danger mb-3">@submissionError</div>
                    }

                    <div class="form-group mb-3 text-center">
                        <label class="form-label d-block fw-semibold mb-2">Your Rating</label>
                        <StarRating Rating="@newReview.Rating" 
                                    RatingChanged="@(r => newReview.Rating = r)" 
                                    IsReadOnly="false" 
                                    Size="lg" 
                                    ShowScore="true" 
                                    ShowCount="false" />
                        <ValidationMessage For="@(() => newReview.Rating)" class="text-danger small mt-1" />
                    </div>

                    <div class="form-group mb-3">
                        <label class="form-label fw-semibold" for="reviewComment">Your Feedback & Comments</label>
                        <InputTextArea id="reviewComment" 
                                       class="form-control" 
                                       rows="4" 
                                       placeholder="Share details about your collaboration, work quality, responsiveness, or campus service..."
                                       @bind-Value="newReview.Comment" />
                        <ValidationMessage For="@(() => newReview.Comment)" class="text-danger small" />
                    </div>
                </div>

                <div class="modal-footer-custom">
                    <button type="button" class="btn btn-secondary" @onclick="CloseReviewModal" disabled="@isSubmitting">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@isSubmitting">
                        <i class="bi bi-send me-1"></i>@(isSubmitting ? "Submitting..." : "Post Review")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

