@using StudentJobHub.Client.Services
@using StudentJobHub.Client.Models

@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject ThemeService ThemeService
@implements IDisposable
@inject AuthService AuthService
@inject UserApiService UserService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!-- Updated Top Navbar with Search and Utilities -->
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <!-- Right Side Utility Controls -->
            <div class="d-flex align-items-center gap-3 ms-auto">
                <!-- Notifications Icon -->
                <a href="/notifications" class="icon-btn position-relative" title="Notifications">
                    <i class="bi bi-bell fs-5"></i>
                </a>

                <button type="button"
                        class="theme-toggle-btn"
                        @onclick="ToggleTheme"
                        aria-label="@(ThemeService.IsDarkMode ? "Switch to light mode" : "Switch to dark mode")">
                    <i class="bi @(ThemeService.IsDarkMode ? "bi-sun" : "bi-moon")"></i>
                    <span>@(ThemeService.IsDarkMode ? "Light mode" : "Dark mode")</span>
                </button>

                <!-- Vertical Divider -->
                <div class="vr mx-1"></div>

                <!-- User Profile Quick Badge -->
<a href="/profile" class="user-badge text-decoration-none d-flex align-items-center gap-2">
    <div class="user-avatar-sm">
        @if (!string.IsNullOrEmpty(user?.ProfilePictureUrl))
        {
            <img src="@user.ProfilePictureUrl" alt="User Profile" class="avatar-img" />
        }
        else
        {
            <i class="bi bi-person-fill"></i>
        }
    </div>
    <span class="d-none d-md-inline fw-semibold text-dark">My Account</span>
</a>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
        
        <FooterLayout />
    </main>

    <ToastContainer />
</div>

<style>
    .top-row {
        height: 3.5rem;
        background-color: #ffffff;
        border-bottom: 1px solid #e5e7eb;
        transition: background-color 0.2s, border-color 0.2s;
    }

    body.dark-mode .top-row {
        background-color: #1e293b;
        border-bottom: 1px solid #334155;
    }

    .topbar-search {
        width: 320px;
    }

    .search-input:focus {
        box-shadow: none;
        border-color: #d1d5db;
    }

    .icon-btn {
        background: transparent;
        border: none;
        color: #4b5563;
        font-size: 1.1rem;
        cursor: pointer;
        padding: 6px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background-color 0.2s, color 0.2s;
    }

    body.dark-mode .icon-btn {
        color: #94a3b8;
    }

    .icon-btn:hover {
        background-color: #f3f4f6;
        color: #2563eb;
    }

    body.dark-mode .icon-btn:hover {
        background-color: #334155;
        color: #60a5fa;
    }

    .theme-toggle-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

   .user-avatar-sm {
    width: 34px;
    height: 34px;
    border-radius: 50%; 
    background-color: #2563eb; 
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    font-size: 1.1rem;
    flex-shrink: 0;
}

.avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover; 
}

    @@media (max-width: 576px) {
        .topbar-search {
            width: 180px;
        }
    }
</style>

@code {
    private UserModel? user;
    private string searchTerm = "";

    protected override async Task OnInitializedAsync()
    {
        ThemeService.OnThemeChanged += StateHasChangedHandler;
        await LoadUserProfile();
    }

    private async Task LoadUserProfile()
    {
        try
        {
            // Example: Fetch logged-in user profile from UserApiService or AuthService
            // user = await UserService.GetCurrentUserAsync();
        }
        catch
        {
            // Fallback gracefully if not logged in
            user = null;
        }
    }

    private void StateHasChangedHandler()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleThemeAsync();
    }

    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ExecuteSearch();
        }
    }

    private void ExecuteSearch()
    {
        if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            var query = Uri.EscapeDataString(searchTerm.Trim());
            Navigation.NavigateTo($"/jobs?q={query}");
            searchTerm = "";
        }
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChangedHandler;
    }
}