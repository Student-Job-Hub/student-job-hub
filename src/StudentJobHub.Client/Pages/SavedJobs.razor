@page "/saved-jobs"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject BookmarkApiService BookmarkService
@inject ToastService ToastService
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Saved Jobs | Student Job Hub</PageTitle>

<div class="saved-jobs-page">

    <div class="page-header">
        <div>
            <h1>Saved Jobs</h1>
            <p>
                Keep track of interesting job opportunities you've bookmarked to apply later.
            </p>
        </div>

        <a href="/jobs" class="browse-button">
            Browse All Jobs
        </a>
    </div>

    @if (isLoading)
    {
        <div class="jobs-grid">
            <SkeletonCard />
            <SkeletonCard />
            <SkeletonCard />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <h3>Unable to load saved jobs</h3>
            <p>@errorMessage</p>
            <button @onclick="LoadSavedJobsAsync">Try Again</button>
        </div>
    }
    else if (bookmarks.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-bookmark-heart"></i></div>
            <h2>No saved jobs yet</h2>
            <p>
                You haven't bookmarked any jobs yet. When browsing jobs, click the bookmark icon to save opportunities for easy access.
            </p>
            <a href="/jobs" class="browse-button">
                Explore Campus Jobs
            </a>
        </div>
    }
    else
    {
        <div class="jobs-toolbar">
            <span>
                <strong>@FilteredBookmarks.Count()</strong> saved job@(FilteredBookmarks.Count() == 1 ? "" : "s")
            </span>

            <div style="display:flex; gap:10px; align-items:center; flex-wrap: wrap;">
                <input type="text"
                       placeholder="Search saved jobs..."
                       @bind="searchTerm"
                       @bind:event="oninput"
                       style="padding: 6px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem;" />

                <select @bind="selectedCategory" style="padding: 6px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem;">
                    <option value="All">All Categories</option>
                    @foreach (var cat in Categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>

                <select @bind="selectedStatus" style="padding: 6px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem;">
                    <option value="All">All Status</option>
                    <option value="Open">Open Only</option>
                    <option value="Closed">Closed Only</option>
                </select>
            </div>
        </div>

        <div class="jobs-grid">
            @foreach (var item in FilteredBookmarks)
            {
                <div class="saved-job-card">
                    <div class="card-header">
                        <div class="header-left">
                            <div class="job-icon"><i class="bi bi-briefcase-fill"></i></div>
                            <div>
                                <span class="category-badge">@item.Category</span>
                            </div>
                        </div>

                        <div style="display: flex; align-items: center; gap: 8px;">
                            @if (item.IsOpen)
                            {
                                <span class="status-badge open">Open</span>
                            }
                            else
                            {
                                <span class="status-badge closed">Closed</span>
                            }

                            <button class="remove-bookmark-btn" 
                                    title="Remove from saved" 
                                    @onclick="() => RemoveBookmarkAsync(item.JobId)"
                                    disabled="@(removingJobId == item.JobId)">
                                <i class="bi bi-bookmark-fill" style="color: #2563eb; font-size: 1.25rem;"></i>
                            </button>
                        </div>
                    </div>

                    <div class="card-body">
                        <h2>@item.Title</h2>
                        <p class="description">@item.Description</p>

                        <div class="info-grid">
                            <div>
                                <span class="label">Budget</span>
                                <strong>GH₵ @item.Budget.ToString("N2")</strong>
                            </div>
                            <div>
                                <span class="label">Deadline</span>
                                <strong>@item.Deadline.ToString("dd MMM yyyy")</strong>
                            </div>
                            <div>
                                <span class="label">Saved On</span>
                                <strong>@item.SavedAt.ToString("dd MMM yyyy")</strong>
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(item.Requirements))
                        {
                            <div class="requirements-box">
                                <span class="label">Requirements</span>
                                <p>@item.Requirements</p>
                            </div>
                        }

                        <div class="card-footer">
                            <div class="posted-by">
                                <span class="avatar">
                                    @(string.IsNullOrWhiteSpace(item.PostedByName) ? "?" : item.PostedByName.Substring(0, 1).ToUpper())
                                </span>
                                <div>
                                    <small>Posted by</small>
                                    <strong>@item.PostedByName</strong>
                                </div>
                            </div>

                            <div style="display:flex; gap: 8px;">
                                <a href="/jobs/@item.JobId" class="view-button">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
    .saved-jobs-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 24px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin: 0 0 6px;
        font-size: 2.2rem;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .browse-button {
        display: inline-block;
        padding: 10px 18px;
        background: #2563eb;
        color: white;
        text-decoration: none;
        font-weight: 600;
        border-radius: 8px;
    }

    .browse-button:hover {
        background: #1d4ed8;
    }

    .jobs-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .jobs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 24px;
    }

    .saved-job-card {
        background: rgba(232, 228, 232, 0.59);
        border: 1px solid #576a91ff;
        border-radius: 12px;
        overflow: hidden;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        display: flex;
        flex-direction: column;
    }

    .saved-job-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 20px 0;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .job-icon {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #2563eb;
    }

    .category-badge {
        background: #e0f2fe;
        color: #0369a1;
        font-weight: 600;
        font-size: 11px;
        padding: 4px 8px;
        border-radius: 12px;
    }

    .status-badge {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-badge.open {
        background: green;
        color: white;
    }

    .status-badge.closed {
        background: #a92f2fff;
        color: white;
    }

    .remove-bookmark-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px 6px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s ease;
    }

    .remove-bookmark-btn:hover {
        transform: scale(1.15);
    }

    .card-body {
        padding: 16px 20px 20px;
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .card-body h2 {
        margin: 0 0 10px;
        font-size: 1.25rem;
    }

    .description {
        color: #6b7280;
        line-height: 1.5;
        font-size: 0.92rem;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 16px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        padding: 12px 0;
        border-top: 1px solid #e5e7eb;
        border-bottom: 1px solid #e5e7eb;
        margin-bottom: 14px;
    }

    .info-grid div {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .label {
        font-size: 11px;
        color: #6b7280;
    }

    .info-grid strong {
        font-size: 13px;
    }

    .requirements-box {
        margin-bottom: 16px;
    }

    .requirements-box p {
        margin: 4px 0 0;
        font-size: 13px;
        color: #4b5563;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: auto;
        padding-top: 12px;
    }

    .posted-by {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #2563eb;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 12px;
    }

    .posted-by small {
        font-size: 10px;
        color: #9ca3af;
        display: block;
    }

    .posted-by strong {
        font-size: 12px;
    }

    .view-button {
        background: #111827;
        color: white;
        padding: 8px 14px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
    }

    .view-button:hover {
        background: #374151;
    }

    .empty-state,
    .error-state {
        padding: 60px 20px;
        text-align: center;
        background: #f9fafb;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
    }

    .empty-icon {
        font-size: 52px;
        color: #2563eb;
        margin-bottom: 12px;
    }

    .empty-state h2 {
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #6b7280;
        max-width: 480px;
        margin: 0 auto 20px;
        line-height: 1.6;
    }

    .error-state {
        background: #fef2f2;
        color: #991b1b;
    }

    .error-state button {
        margin-top: 12px;
        padding: 8px 16px;
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
    }
</style>

@code {
    private List<JobBookmarkModel> bookmarks = new();
    private bool isLoading = true;
    private string? errorMessage;
    private int? removingJobId;

    private string searchTerm = string.Empty;
    private string selectedCategory = "All";
    private string selectedStatus = "All";

    private IEnumerable<string> Categories =>
        bookmarks.Select(b => b.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c);

    private IEnumerable<JobBookmarkModel> FilteredBookmarks
    {
        get
        {
            var query = bookmarks.AsEnumerable();

            if (selectedCategory != "All")
            {
                query = query.Where(b => b.Category == selectedCategory);
            }

            if (selectedStatus == "Open")
            {
                query = query.Where(b => b.IsOpen);
            }
            else if (selectedStatus == "Closed")
            {
                query = query.Where(b => !b.IsOpen);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLowerInvariant();
                query = query.Where(b =>
                    (b.Title != null && b.Title.ToLowerInvariant().Contains(term)) ||
                    (b.Description != null && b.Description.ToLowerInvariant().Contains(term)) ||
                    (b.Category != null && b.Category.ToLowerInvariant().Contains(term)) ||
                    (b.PostedByName != null && b.PostedByName.ToLowerInvariant().Contains(term))
                );
            }

            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login?returnUrl=/saved-jobs");
            return;
        }

        await LoadSavedJobsAsync();
    }

    private async Task LoadSavedJobsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            bookmarks = await BookmarkService.GetBookmarksAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/saved-jobs");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load saved jobs: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task RemoveBookmarkAsync(int jobId)
    {
        removingJobId = jobId;
        try
        {
            var res = await BookmarkService.RemoveBookmarkAsync(jobId);
            if (res.IsSuccessStatusCode)
            {
                bookmarks.RemoveAll(b => b.JobId == jobId);
                ToastService.ShowSuccess("Job removed from saved bookmarks.");
            }
            else
            {
                ToastService.ShowError("Could not remove bookmark.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            removingJobId = null;
        }
    }
}
