@page "/export-data"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ExportApiService ExportService
@inject AuthService AuthService
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Data Export Center | Student Job Hub</PageTitle>

<div class="export-page">

    <div class="page-header">
        <div>
            <h1>Data Export Center</h1>
            <p>Download, archive, and print your job applications, posted listings, and service booking history.</p>
        </div>

        <button class="print-portfolio-btn" @onclick="PrintReportAsync" disabled="@isPrinting">
            <i class="bi bi-printer-fill"></i> @(isPrinting ? "Generating..." : "Print / PDF Career Report")
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <SkeletonCard />
            <SkeletonCard />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <h3>Unable to load export center</h3>
            <p>@errorMessage</p>
            <button @onclick="LoadSummaryAsync">Try Again</button>
        </div>
    }
    else
    {
        <!-- Summary Stats Banner -->
        @if (summary != null)
        {
            <div class="stats-banner">
                <div class="stat-item">
                    <span class="stat-count">@summary.Applications.Count</span>
                    <span class="stat-label">Applications</span>
                </div>
                <div class="stat-item">
                    <span class="stat-count">@summary.PostedJobs.Count</span>
                    <span class="stat-label">Jobs Posted</span>
                </div>
                <div class="stat-item">
                    <span class="stat-count">@(summary.ClientBookings.Count + summary.ProviderBookings.Count)</span>
                    <span class="stat-label">Service Bookings</span>
                </div>
                <div class="stat-item">
                    <span class="stat-count">@summary.BookmarkedJobs.Count</span>
                    <span class="stat-label">Saved Jobs</span>
                </div>
            </div>
        }

        <!-- Export Cards Grid -->
        <div class="export-cards-grid">

            <!-- Card 1: Job Applications -->
            <div class="export-card">
                <div class="card-top">
                    <div class="export-icon" style="background:#eff6ff; color:#2563eb;">
                        <i class="bi bi-file-earmark-text-fill"></i>
                    </div>
                    <div>
                        <h2>Job Applications History</h2>
                        <span class="record-badge">@(summary?.Applications.Count ?? 0) records found</span>
                    </div>
                </div>

                <p class="export-desc">
                    Export your complete application records including job titles, company/employer names, application status (Accepted, Pending, Rejected), submission dates, and pitch messages.
                </p>

                <div class="card-actions">
                    <button class="download-btn csv" @onclick="DownloadApplicationsCsvAsync" disabled="@isDownloadingApps">
                        <i class="bi bi-filetype-csv"></i> @(isDownloadingApps ? "Downloading..." : "Download CSV")
                    </button>
                </div>
            </div>

            <!-- Card 2: Posted Jobs -->
            <div class="export-card">
                <div class="card-top">
                    <div class="export-icon" style="background:#f0fdf4; color:#16a34a;">
                        <i class="bi bi-briefcase-fill"></i>
                    </div>
                    <div>
                        <h2>Posted Jobs & Listings</h2>
                        <span class="record-badge">@(summary?.PostedJobs.Count ?? 0) listings found</span>
                    </div>
                </div>

                <p class="export-desc">
                    Export all job opportunities you posted on campus with budget allocations, deadlines, application counts, status, and job requirements.
                </p>

                <div class="card-actions">
                    <button class="download-btn csv" @onclick="DownloadJobsCsvAsync" disabled="@isDownloadingJobs">
                        <i class="bi bi-filetype-csv"></i> @(isDownloadingJobs ? "Downloading..." : "Download CSV")
                    </button>
                </div>
            </div>

            <!-- Card 3: Service Bookings -->
            <div class="export-card">
                <div class="card-top">
                    <div class="export-icon" style="background:#fef3c7; color:#d97706;">
                        <i class="bi bi-calendar-check-fill"></i>
                    </div>
                    <div>
                        <h2>Service Bookings History</h2>
                        <span class="record-badge">@((summary?.ClientBookings.Count ?? 0) + (summary?.ProviderBookings.Count ?? 0)) booking records</span>
                    </div>
                </div>

                <p class="export-desc">
                    Export records of services you requested and bookings received for your freelance services, including agreed pricing, dates, locations, and provider responses.
                </p>

                <div class="card-actions">
                    <button class="download-btn csv" @onclick="DownloadBookingsCsvAsync" disabled="@isDownloadingBookings">
                        <i class="bi bi-filetype-csv"></i> @(isDownloadingBookings ? "Downloading..." : "Download CSV")
                    </button>
                </div>
            </div>

            <!-- Card 4: Full Career & Activity Report -->
            <div class="export-card full-archive-card">
                <div class="card-top">
                    <div class="export-icon" style="background:#faf5ff; color:#9333ea;">
                        <i class="bi bi-award-fill"></i>
                    </div>
                    <div>
                        <h2>Complete Portfolio & JSON Archive</h2>
                        <span class="record-badge premium">All Activity</span>
                    </div>
                </div>

                <p class="export-desc">
                    Generate an official printable report formatted for PDF export or download your entire account data archive in structured JSON format.
                </p>

                <div class="card-actions">
                    <button class="download-btn print" @onclick="PrintReportAsync" disabled="@isPrinting">
                        <i class="bi bi-file-earmark-pdf-fill"></i> Print / Save as PDF
                    </button>
                </div>
            </div>

        </div>
    }

</div>

<style>
    .export-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 40px 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .page-header h1 {
        margin: 0 0 6px;
        font-size: 2.2rem;
        font-weight: 700;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .print-portfolio-btn {
        background: #2563eb;
        color: white;
        border: none;
        padding: 12px 22px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.95rem;
        transition: background 0.2s ease;
    }

    .print-portfolio-btn:hover {
        background: #1d4ed8;
    }

    .stats-banner {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        background: rgba(232, 228, 232, 0.59);
        border: 1px solid #576a91ff;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 32px;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .stat-count {
        font-size: 1.8rem;
        font-weight: 700;
        color: #0f172a;
    }

    .stat-label {
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        font-weight: 600;
        margin-top: 2px;
    }

    .export-cards-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    .export-card {
        background: rgba(232, 228, 232, 0.59);
        border: 1px solid #576a91ff;
        border-radius: 14px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .export-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    }

    .card-top {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 14px;
    }

    .export-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .card-top h2 {
        margin: 0 0 4px;
        font-size: 1.25rem;
    }

    .record-badge {
        font-size: 11px;
        font-weight: 600;
        color: #64748b;
        background: #f1f5f9;
        padding: 2px 8px;
        border-radius: 10px;
    }

    .record-badge.premium {
        background: #f3e8ff;
        color: #7e22ce;
    }

    .export-desc {
        color: #4b5563;
        font-size: 0.92rem;
        line-height: 1.6;
        margin-bottom: 20px;
        flex: 1;
    }

    .card-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .download-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 16px;
        border-radius: 7px;
        font-weight: 600;
        font-size: 0.9rem;
        cursor: pointer;
        border: 1px solid transparent;
        transition: all 0.2s ease;
    }

    .download-btn.csv {
        background: #f1f5f9;
        color: #0f172a;
        border-color: #cbd5e1;
    }

    .download-btn.csv:hover {
        background: #e2e8f0;
        color: #2563eb;
    }

    .download-btn.print {
        background: #7e22ce;
        color: white;
    }

    .download-btn.print:hover {
        background: #6b21a8;
    }

    .empty-state, .error-state, .loading-state {
        padding: 60px 20px;
        text-align: center;
    }

    @@media (max-width: 800px) {
        .export-cards-grid {
            grid-template-columns: 1fr;
        }

        .stats-banner {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

@code {
    private ExportSummaryModel? summary;
    private bool isLoading = true;
    private string? errorMessage;

    private bool isDownloadingApps = false;
    private bool isDownloadingJobs = false;
    private bool isDownloadingBookings = false;
    private bool isPrinting = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login?returnUrl=/export-data");
            return;
        }

        await LoadSummaryAsync();
    }

    private async Task LoadSummaryAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            summary = await ExportService.GetSummaryJsonAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/export-data");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load export center: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DownloadApplicationsCsvAsync()
    {
        isDownloadingApps = true;
        try
        {
            var ok = await ExportService.DownloadApplicationsCsvAsync();
            if (ok) ToastService.ShowSuccess("Applications CSV downloaded!");
            else ToastService.ShowError("Failed to export applications.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isDownloadingApps = false;
        }
    }

    private async Task DownloadJobsCsvAsync()
    {
        isDownloadingJobs = true;
        try
        {
            var ok = await ExportService.DownloadJobsCsvAsync();
            if (ok) ToastService.ShowSuccess("Posted jobs CSV downloaded!");
            else ToastService.ShowError("Failed to export jobs.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isDownloadingJobs = false;
        }
    }

    private async Task DownloadBookingsCsvAsync()
    {
        isDownloadingBookings = true;
        try
        {
            var ok = await ExportService.DownloadBookingsCsvAsync();
            if (ok) ToastService.ShowSuccess("Service bookings CSV downloaded!");
            else ToastService.ShowError("Failed to export bookings.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isDownloadingBookings = false;
        }
    }

    private async Task PrintReportAsync()
    {
        isPrinting = true;
        try
        {
            await ExportService.OpenPrintReportAsync();
            ToastService.ShowSuccess("Career report ready for printing/PDF saving!");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error generating print report: {ex.Message}");
        }
        finally
        {
            isPrinting = false;
        }
    }
}
