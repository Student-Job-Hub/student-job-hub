@code {
    private List<ServiceBookingModel> myRequests = new();
    private List<ServiceBookingModel> receivedBookings = new();
    private string activeTab = "my-requests";
    private bool isLoading = true;
    private bool isExporting = false;
    private string? errorMessage;
    private int? busyBookingId;

    // Action Modal State
    private ServiceBookingModel? selectedBookingForAction;
    private string targetActionStatus = string.Empty;
    private string actionModalTitle = string.Empty;
    private string providerResponseText = string.Empty;
    private bool isSubmittingStatus = false;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login?returnUrl=/my-bookings");
            return;
        }

        await LoadBookingsAsync();
    }

    private async Task LoadBookingsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            myRequests = await BookingService.GetMyRequestsAsync();
            receivedBookings = await BookingService.GetReceivedBookingsAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/login?returnUrl=/my-bookings");
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load bookings: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task CancelBookingAsync(int id)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to cancel this booking request?");
        if (!confirmed) return;

        busyBookingId = id;
        try
        {
            var res = await BookingService.UpdateStatusAsync(id, new UpdateBookingStatusModel { Status = "Cancelled" });
            if (res.IsSuccessStatusCode)
            {
                var item = myRequests.FirstOrDefault(b => b.Id == id);
                if (item != null) item.Status = "Cancelled";
                ToastService.ShowSuccess("Booking request cancelled.");
            }
            else
            {
                ToastService.ShowError("Unable to cancel booking.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            busyBookingId = null;
        }
    }

    private void OpenResponseModal(ServiceBookingModel booking, string status)
    {
        selectedBookingForAction = booking;
        targetActionStatus = status;
        providerResponseText = string.Empty;
        actionModalTitle = status switch
        {
            "Accepted" => "Accept Booking Request",
            "Declined" => "Decline Booking Request",
            "Completed" => "Mark Service Completed",
            _ => "Update Booking Status"
        };
    }

    private void CloseResponseModal()
    {
        selectedBookingForAction = null;
        targetActionStatus = string.Empty;
        providerResponseText = string.Empty;
    }

    private async Task SubmitStatusUpdateAsync()
    {
        if (selectedBookingForAction == null) return;

        isSubmittingStatus = true;
        try
        {
            var model = new UpdateBookingStatusModel
            {
                Status = targetActionStatus,
                ProviderResponse = providerResponseText
            };

            var res = await BookingService.UpdateStatusAsync(selectedBookingForAction.Id, model);
            if (res.IsSuccessStatusCode)
            {
                selectedBookingForAction.Status = targetActionStatus;
                selectedBookingForAction.ProviderResponse = providerResponseText;
                ToastService.ShowSuccess($"Booking marked as {targetActionStatus.ToLower()}!");
                CloseResponseModal();
            }
            else
            {
                ToastService.ShowError("Failed to update booking status.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            isSubmittingStatus = false;
        }
    }

    private async Task ExportCsvAsync()
    {
        isExporting = true;
        try
        {
            var ok = await ExportService.DownloadBookingsCsvAsync();
            if (ok)
            {
                ToastService.ShowSuccess("Service bookings CSV downloaded!");
            }
            else
            {
                ToastService.ShowError("Could not download CSV export.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"Export error: {ex.Message}");
        }
        finally
        {
            isExporting = false;
        }
    }

    private static string GetStatusClass(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "pending" => "status-pending",
            "accepted" => "status-accepted",
            "declined" => "status-declined",
            "completed" => "status-completed",
            "cancelled" => "status-cancelled",
            _ => "status-pending"
        };
    }
}
