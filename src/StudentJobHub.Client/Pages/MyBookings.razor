@page "/my-bookings"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject BookingApiService BookingService
@inject ExportApiService ExportService
@inject AuthService AuthService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Service Bookings | Student Job Hub</PageTitle>

<div class="bookings-page">

    <div class="page-header">
        <div>
            <h1>Service Bookings</h1>
            <p>Manage your service requests and client bookings all in one place.</p>
        </div>

        <div class="header-actions">
            <button class="export-btn" @onclick="ExportCsvAsync" disabled="@isExporting">
                <i class="bi bi-filetype-csv"></i> @(isExporting ? "Exporting..." : "Export CSV")
            </button>
            <a href="/services" class="browse-button">
                Browse Services
            </a>
        </div>
    </div>

    <!-- Quick Metrics -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-icon"><i class="bi bi-calendar-event"></i></div>
            <div>
                <span class="metric-label">My Requests</span>
                <h3>@myRequests.Count</h3>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon" style="background:#f0fdf4; color:#16a34a;"><i class="bi bi-inbox-fill"></i></div>
            <div>
                <span class="metric-label">Received Requests</span>
                <h3>@receivedBookings.Count</h3>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon" style="background:#fef3c7; color:#d97706;"><i class="bi bi-hourglass-split"></i></div>
            <div>
                <span class="metric-label">Pending Action</span>
                <h3>@(receivedBookings.Count(b => b.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)) + myRequests.Count(b => b.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)))</h3>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon" style="background:#eff6ff; color:#2563eb;"><i class="bi bi-check2-circle"></i></div>
            <div>
                <span class="metric-label">Completed Services</span>
                <h3>@(receivedBookings.Count(b => b.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase)) + myRequests.Count(b => b.Status.Equals("Completed", StringComparison.OrdinalIgnoreCase)))</h3>
            </div>
        </div>
    </div>

    <!-- Tab Navigation -->
    <div class="tab-navigation">
        <button class="tab-btn @(activeTab == "my-requests" ? "active" : "")" @onclick='() => activeTab = "my-requests"'>
            <i class="bi bi-send"></i> My Service Requests (@myRequests.Count)
        </button>
        <button class="tab-btn @(activeTab == "received" ? "active" : "")" @onclick='() => activeTab = "received"'>
            <i class="bi bi-inbox"></i> Requests for My Services (@receivedBookings.Count)
            @if (receivedBookings.Any(b => b.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase)))
            {
                <span class="tab-badge">@receivedBookings.Count(b => b.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))</span>
            }
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <SkeletonCard />
            <SkeletonCard />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <h3>Unable to load bookings</h3>
            <p>@errorMessage</p>
            <button @onclick="LoadBookingsAsync">Try Again</button>
        </div>
    }
    else
    {
        <!-- TAB 1: MY REQUESTS (As Client) -->
        @if (activeTab == "my-requests")
        {
            @if (myRequests.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-calendar2-x"></i></div>
                    <h2>No service requests yet</h2>
                    <p>
                        You haven't requested or booked any services from campus providers.
                    </p>
                    <a href="/services" class="browse-button">Find Campus Services</a>
                </div>
            }
            else
            {
                <div class="bookings-list">
                    @foreach (var booking in myRequests)
                    {
                        <div class="booking-card">
                            <div class="booking-header">
                                <div>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <h2>@booking.ServiceTitle</h2>
                                        <span class="category-badge">@booking.ServiceCategory</span>
                                    </div>
                                    <p class="meta-sub">
                                        Provider: <strong>@booking.ProviderName</strong> (@booking.ProviderEmail)
                                    </p>
                                </div>

                                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                                    <span class="status-badge @GetStatusClass(booking.Status)">
                                        @booking.Status
                                    </span>
                                    <span class="price-tag">GH₵ @booking.ProposedPrice.ToString("N2")</span>
                                </div>
                            </div>

                            <div class="booking-details-grid">
                                <div>
                                    <span class="detail-label"><i class="bi bi-calendar-check"></i> Preferred Date</span>
                                    <strong>@booking.RequestedDate.ToString("MMM dd, yyyy")</strong>
                                </div>
                                <div>
                                    <span class="detail-label"><i class="bi bi-geo-alt"></i> Location / Delivery</span>
                                    <strong>@(string.IsNullOrWhiteSpace(booking.LocationOrDelivery) ? "On Campus / Remote" : booking.LocationOrDelivery)</strong>
                                </div>
                                <div>
                                    <span class="detail-label"><i class="bi bi-clock-history"></i> Requested On</span>
                                    <strong>@booking.CreatedAt.ToString("MMM dd, yyyy")</strong>
                                </div>
                            </div>

                            <div class="notes-box">
                                <span class="detail-label">Your Request Notes</span>
                                <p>@booking.Notes</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(booking.ProviderResponse))
                            {
                                <div class="response-box">
                                    <span class="detail-label"><i class="bi bi-chat-quote"></i> Response from Provider</span>
                                    <p>@booking.ProviderResponse</p>
                                </div>
                            }

                            <div class="booking-footer">
                                <a href="/services/@booking.ServiceId" class="details-button">
                                    View Service
                                </a>

                                @if (booking.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase) || booking.Status.Equals("Accepted", StringComparison.OrdinalIgnoreCase))
                                {
                                    <button class="cancel-button" 
                                            @onclick="() => CancelBookingAsync(booking.Id)"
                                            disabled="@(busyBookingId == booking.Id)">
                                        @(busyBookingId == booking.Id ? "Cancelling..." : "Cancel Request")
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <!-- TAB 2: RECEIVED REQUESTS (As Provider) -->
        @if (activeTab == "received")
        {
            @if (receivedBookings.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-inbox"></i></div>
                    <h2>No received booking requests</h2>
                    <p>
                        You haven't received any booking requests for your services yet. Make sure your freelance services are active in the marketplace.
                    </p>
                    <a href="/create-service" class="browse-button">+ Offer a New Service</a>
                </div>
            }
            else
            {
                <div class="bookings-list">
                    @foreach (var booking in receivedBookings)
                    {
                        <div class="booking-card">
                            <div class="booking-header">
                                <div>
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <h2>@booking.ServiceTitle</h2>
                                        <span class="category-badge">@booking.ServiceCategory</span>
                                    </div>
                                    <p class="meta-sub">
                                        Client: <strong>@booking.ClientName</strong> (@booking.ClientEmail) @(!string.IsNullOrWhiteSpace(booking.ClientUniversity) ? $"• {booking.ClientUniversity}" : "")
                                    </p>
                                </div>

                                <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
                                    <span class="status-badge @GetStatusClass(booking.Status)">
                                        @booking.Status
                                    </span>
                                    <span class="price-tag">GH₵ @booking.ProposedPrice.ToString("N2")</span>
                                </div>
                            </div>

                            <div class="booking-details-grid">
                                <div>
                                    <span class="detail-label"><i class="bi bi-calendar-check"></i> Target Date</span>
                                    <strong>@booking.RequestedDate.ToString("MMM dd, yyyy")</strong>
                                </div>
                                <div>
                                    <span class="detail-label"><i class="bi bi-geo-alt"></i> Location</span>
                                    <strong>@(string.IsNullOrWhiteSpace(booking.LocationOrDelivery) ? "On Campus / Remote" : booking.LocationOrDelivery)</strong>
                                </div>
                                <div>
                                    <span class="detail-label"><i class="bi bi-clock-history"></i> Received On</span>
                                    <strong>@booking.CreatedAt.ToString("MMM dd, yyyy")</strong>
                                </div>
                            </div>

                            <div class="notes-box">
                                <span class="detail-label">Client's Project / Requirement Details</span>
                                <p>@booking.Notes</p>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(booking.ProviderResponse))
                            {
                                <div class="response-box">
                                    <span class="detail-label">Your Response</span>
                                    <p>@booking.ProviderResponse</p>
                                </div>
                            }

                            <div class="booking-footer">
                                <a href="/services/@booking.ServiceId" class="details-button">
                                    View Service
                                </a>

                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    @if (booking.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button class="accept-button" 
                                                @onclick='() => OpenResponseModal(booking, "Accepted")'
                                                disabled="@(busyBookingId == booking.Id)">
                                            <i class="bi bi-check-lg"></i> Accept Booking
                                        </button>
                                        <button class="decline-button" 
                                                @onclick='() => OpenResponseModal(booking, "Declined")'
                                                disabled="@(busyBookingId == booking.Id)">
                                            <i class="bi bi-x-lg"></i> Decline
                                        </button>
                                    }
                                    else if (booking.Status.Equals("Accepted", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button class="complete-button" 
                                                @onclick='() => OpenResponseModal(booking, "Completed")'
                                                disabled="@(busyBookingId == booking.Id)">
                                            <i class="bi bi-check2-all"></i> Mark Completed
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }

</div>

<!-- Provider Status Update / Response Modal -->
@if (selectedBookingForAction != null)
{
    <div class="modal-backdrop-custom">
        <div class="modal-dialog-custom" style="max-width: 520px;">
            <div class="modal-header-custom" style="display:flex; justify-content:space-between; align-items:center;">
                <h3>@actionModalTitle</h3>
                <button type="button" class="close-btn" @onclick="CloseResponseModal">&times;</button>
            </div>

            <div class="modal-body-custom">
                <p>
                    Update booking status for <strong>@selectedBookingForAction.ClientName</strong> on <em>@selectedBookingForAction.ServiceTitle</em>.
                </p>

                <div style="margin-top: 12px;">
                    <label style="font-weight: 600; font-size: 0.9rem; margin-bottom: 6px; display: block;">
                        Message / Note to Client (Optional)
                    </label>
                    <textarea @bind="providerResponseText" 
                              rows="4" 
                              class="form-control" 
                              placeholder="e.g., 'Looking forward to working with you! Let's meet at Balme Library at 2pm.' or explanation if declined..."></textarea>
                </div>
            </div>

            <div class="modal-footer-custom" style="margin-top: 20px;">
                <button class="btn btn-secondary" @onclick="CloseResponseModal" disabled="@isSubmittingStatus">
                    Cancel
                </button>
                <button class="btn @(targetActionStatus == "Declined" ? "btn-danger" : "btn-primary")" 
                        @onclick="SubmitStatusUpdateAsync" 
                        disabled="@isSubmittingStatus">
                    @(isSubmittingStatus ? "Saving..." : $"Confirm {targetActionStatus}")
                </button>
            </div>
        </div>
    </div>
}

