@page "/services/edit/{Id:int}"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ServiceApiService ServiceApiService
@inject NavigationManager Navigation

<PageTitle>Edit Service | Student Job Hub</PageTitle>

<div class="page-container">
	@if (isLoading)
	{
		<div class="loading-state">Loading service...</div>
	}
	else if (!string.IsNullOrEmpty(errorMessage))
	{
		<div class="error-state">
			<h2>Unable to edit service</h2>
			<p>@errorMessage</p>
			<a href="/services">Back to Services</a>
		</div>
	}
	else
	{
		<h1>Edit Service</h1>
		<EditForm Model="@model" OnValidSubmit="SaveAsync">
			<DataAnnotationsValidator />
			<div class="form-group">
				<label>Title</label>
				<InputText class="form-control" @bind-Value="model.Title" />
			</div>
			<div class="form-group">
				<label>Category</label>
				<InputText class="form-control" @bind-Value="model.Category" />
			</div>
			<div class="form-group">
				<label>Description</label>
				<InputTextArea class="form-control" @bind-Value="model.Description" rows="5" />
			</div>
			<div class="form-group">
				<label>Price (GH₵)</label>
				<InputNumber class="form-control" @bind-Value="model.Price" />
			</div>
			@if (!string.IsNullOrEmpty(saveError))
			{
				<p class="error-message">@saveError</p>
			}
			<button type="submit" class="secondary-button" disabled="@isSaving">
				@(isSaving ? "Saving..." : "Save Changes")
			</button>
			<a href="/services" class="cancel-button">Cancel</a>
		</EditForm>
	}
</div>

@code {
	[Parameter] public int Id { get; set; }

	private CreateServiceModel model = new();
	private bool isLoading = true;
	private bool isSaving;
	private string? errorMessage;
	private string? saveError;

	protected override async Task OnInitializedAsync()
	{
		try
		{
			var service = await ServiceApiService.GetByIdAsync(Id);
			if (service is null)
			{
				errorMessage = "The service could not be found.";
			}
			else
			{
				model = new CreateServiceModel
				{
					Title = service.Title,
					Description = service.Description,
					Category = service.Category,
					Price = service.Price
				};
			}
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
		finally
		{
			isLoading = false;
		}
	}

	private async Task SaveAsync()
	{
		isSaving = true;
		saveError = null;
		try
		{
			var response = await ServiceApiService.UpdateAsync(Id, model);
			if (response.IsSuccessStatusCode)
			{
				Navigation.NavigateTo($"/services/{Id}");
			}
			else
			{
				saveError = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
					? "You must be logged in and own this service to edit it."
					: "Unable to update the service.";
			}
		}
		catch (Exception ex)
		{
			saveError = ex.Message;
		}
		finally
		{
			isSaving = false;
		}
	}
}
