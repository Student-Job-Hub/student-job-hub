@page "/my-applications"

@inject ApplicationApiService ApplicationService
@inject IJSRuntime JSRuntime

<PageTitle>My Applications - Student Job Hub</PageTitle>

<div class="applications-page">

    <div class="page-header">
        <div>
            <h1>My Applications</h1>
            <p>Track the jobs you have applied for.</p>
        </div>

        <a href="/jobs" class="browse-button">
            Browse Jobs
        </a>
    </div>

    @if (isLoading)
    {
        <div class="loading-state">
            <p>Loading your applications...</p>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="error-state">
            <p>@errorMessage</p>
            <button @onclick="LoadApplications">
                Try Again
            </button>
        </div>
    }
    else if (applications.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-bag"></i></div>

            <h2>No applications yet</h2>

            <p>
                You haven't applied for any jobs yet.
                Browse available jobs and submit your first application.
            </p>

            <a href="/jobs" class="browse-button">
                Browse Available Jobs
            </a>
        </div>
    }
    else
    {
        <div class="applications-summary">
            <strong>@applications.Count</strong>
            application@(applications.Count == 1 ? "" : "s")
        </div>

        <div class="applications-list">

            @foreach (var application in applications)
            {
                <div class="application-card">

                    <div class="application-header">

                        <div>
                            <h2>@application.JobTitle</h2>

                            <p class="application-date">
                                Applied
                                @application.AppliedAt.ToString("MMM dd, yyyy")
                            </p>
                        </div>

                        <span class="@GetStatusClass(application.Status)">
                            @application.Status
                        </span>

                    </div>

                    <div class="application-message">

                        <h3>Your Message</h3>

                        <p>
                            @application.Message
                        </p>

                    </div>

                    <div class="application-footer">

                        <a
                            href="/jobs/@application.JobId"
                            class="details-button">
                            View Job
                        </a>

                        @if (IsPending(application.Status))
                        {
                            <button
                                class="withdraw-button"
                                @onclick="() => WithdrawApplication(application.Id)">
                                Withdraw Application
                            </button>
                        }

                    </div>

                </div>
            }

        </div>
    }

</div>

<style>

    .applications-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .page-header h1 {
        margin: 0 0 6px;
        font-size: 32px;
    }

    .page-header p {
        margin: 0;
        color: #6b7280;
    }

    .browse-button,
    .details-button {
        display: inline-block;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    .browse-button {
        background:  #2563eb;
        color: white;
    }

    .details-button {
        border: 1px solid ##576a91ff;
        color: #0953c9ff;
        text-decoration: underline;
    }

    .applications-summary {
        margin-bottom: 20px;
        color: #6b7280;
    }

    .applications-summary strong {
        color: #111827;
    }

    .applications-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .application-card {
        padding: 24px;
        background: #e8e4e4ff;
        border: 1px solid #576a91ff;
        border-radius: 12px;
    }

    .application-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding-bottom: 18px;
        border-bottom: 1px solid #e5e7eb;
    }

    .application-header h2 {
        margin: 0 0 6px;
        font-size: 21px;
    }

    .application-date {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
    }

    .status {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-pending {
        background: #fef3c7;
        color: #92400e;
    }

    .status-accepted {
        background: #dcfce7;
        color: #166534;
    }

    .status-rejected {
        background: #fee2e2;
        color: #991b1b;
    }

    .status-completed {
        background: #dbeafe;
        color: #1e40af;
    }

    .status-default {
        background: #f3f4f6;
        color: #374151;
    }

    .application-message {
        padding: 20px 0;
    }

    .application-message h3 {
        margin: 0 0 8px;
        font-size: 15px;
    }

    .application-message p {
        margin: 0;
        color: #4b5563;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    .application-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .withdraw-button {
        border: 1px solid #dc2626;
        background: white;
        color: #dc2626;
        padding: 9px 15px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
    }

    .withdraw-button:hover {
        background: #fee2e2;
    }

    .loading-state,
    .empty-state,
    .error-state {
        padding: 50px 25px;
        text-align: center;
        border-radius: 12px;
        background: #f9fafb;
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 10px;
    }

    .empty-state h2 {
        margin-bottom: 8px;
    }

    .empty-state p {
        max-width: 500px;
        margin: 0 auto 25px;
        color: #6b7280;
        line-height: 1.6;
    }

    .error-state {
        color: #991b1b;
        background: #fee2e2;
    }

    .error-state button {
        margin-top: 10px;
        padding: 9px 15px;
        border: none;
        border-radius: 7px;
        cursor: pointer;
    }

    @@media (max-width: 650px) {

        .page-header,
        .application-header,
        .application-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .browse-button,
        .details-button,
        .withdraw-button {
            text-align: center;
            width: 100%;
        }

        .application-header .status {
            align-self: flex-start;
        }
    }

</style>

@code {

    private List<ApplicationModel> applications = new();

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadApplications();
    }

    private async Task LoadApplications()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            applications =
                await ApplicationService.GetMyApplicationsAsync();
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to load your applications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task WithdrawApplication(int applicationId)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>(
            "confirm",
            "Are you sure you want to withdraw this application?");

        if (!confirmed)
        {
            return;
        }

        try
        {
            var response =
                await ApplicationService.DeleteAsync(applicationId);

            if (response.IsSuccessStatusCode)
            {
                applications.RemoveAll(
                    application => application.Id == applicationId);
            }
            else
            {
                errorMessage =
                    "Unable to withdraw the application.";
            }
        }
        catch (Exception ex)
        {
            errorMessage =
                $"Unable to withdraw the application: {ex.Message}";
        }
    }

    private static bool IsPending(string status)
    {
        return string.Equals(
            status,
            "Pending",
            StringComparison.OrdinalIgnoreCase);
    }

    private static string GetStatusClass(string status)
    {
        return status.ToLowerInvariant() switch
        {
            "pending" => "status status-pending",
            "accepted" => "status status-accepted",
            "rejected" => "status status-rejected",
            "completed" => "status status-completed",
            _ => "status status-default"
        };
    }
}