@page "/jobs/{Id:int}"

@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject JobApiService JobService
@inject ApplicationApiService ApplicationService
@inject AuthService AuthService
@inject UserApiService UserService
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>@(job?.Title ?? "Job Details") | Student Job Hub</PageTitle>

<div class="job-details-page">

    @if (isLoading)
    {
        <div class="loading-container">
            <div class="spinner"></div>
            <p>Loading job details...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">
            <h2>Unable to load job</h2>
            <p>@errorMessage</p>

            <a href="/jobs" class="back-button">
                ← Back to Jobs
            </a>
        </div>
    }
    else if (job == null)
    {
        <div class="empty-state">
            <h2>Job not found</h2>
            <p>The job you're looking for does not exist.</p>

            <a href="/jobs" class="back-button">
                ← Back to Jobs
            </a>
        </div>
    }
    else
    {
        <div class="back-link-container">
            <a href="/jobs" class="back-link">
                ← Back to Jobs
            </a>
        </div>

        <div class="job-details-card">

            <div class="job-details-header">

                <div class="job-title-section">

                    <div class="job-icon"><i class="bi bi-bag"></i></div>

                    <div>
                        <h1>@job.Title</h1>

                        <div class="posted-info">
                            Posted by
                            <strong>@job.PostedByName</strong>
                        </div>
                    </div>

                </div>

                @if (job.IsOpen)
                {
                    <span class="status open">
                        Open
                    </span>
                }
                else
                {
                    <span class="status closed">
                        Closed
                    </span>
                }

            </div>

            <div class="job-summary">

                <div class="summary-item">
                    <span class="summary-label">Budget</span>
                    <strong>
                        GH₵ @job.Budget.ToString("N2")
                    </strong>
                </div>

                <div class="summary-item">
                    <span class="summary-label">Deadline</span>
                    <strong>
                        @job.Deadline.ToString("dd MMM yyyy")
                    </strong>
                </div>

                <div class="summary-item">
                    <span class="summary-label">Posted</span>
                    <strong>
                        @job.CreatedAt.ToString("dd MMM yyyy")
                    </strong>
                </div>

            </div>

            <section class="job-section">

                <h2>Job Description</h2>

                <p>
                    @job.Description
                </p>

            </section>

            <section class="job-section">

                <h2>Requirements</h2>

                <p>
                    @job.Requirements
                </p>

            </section>

            <div class="job-actions">

                @if (isOwner)
                {
                    <div class="owner-action-bar">
                        <a href="/my-jobs/edit/@job.Id" class="apply-button">
                            Edit Job
                        </a>
                        <a href="/my-jobs/@job.Id/applications" class="apply-button secondary-action">
                            View Applications
                        </a>
                        @if (job.IsOpen)
                        {
                            <button class="apply-button secondary-action" @onclick="CloseJobAsync" disabled="@isActionBusy">
                                @(isActionBusy ? "Processing..." : "Close Job")
                            </button>
                        }
                        <button class="delete-action-button" @onclick="DeleteJobAsync" disabled="@isActionBusy">
                            Delete Job
                        </button>
                    </div>
                }
                else if (job.IsOpen)
                {
                    @if (!AuthService.IsLoggedIn)
                    {
                        <a href="/login?returnUrl=/jobs/@job.Id" class="apply-button">
                            Log In to Apply
                        </a>
                    }
                    else if (showApplicationForm)
                    {
                        <EditForm Model="@application" OnValidSubmit="SubmitApplicationAsync">
                            <DataAnnotationsValidator />
                            <label for="application-message">Message to the poster</label>
                            <InputTextArea id="application-message" class="form-control" @bind-Value="application.Message" rows="5" />
                            <ValidationMessage For="@(() => application.Message)" />
                            @if (!string.IsNullOrEmpty(applicationError))
                            {
                                <p class="error-message">@applicationError</p>
                            }
                            <div class="form-actions">
                                <button type="submit" class="apply-button" disabled="@isSubmittingApplication">
                                    @(isSubmittingApplication ? "Submitting..." : "Submit Application")
                                </button>
                                <button type="button" class="back-button" @onclick="CancelApplication">Cancel</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <button class="apply-button" @onclick="() => showApplicationForm = true">
                            Apply for this Job
                        </button>
                    }
                }
                else
                {
                    <button class="apply-button disabled" disabled>
                        Job Closed
                    </button>
                }

            </div>

        </div>
    }

</div>

<style>

    .job-details-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 24px;
    }

    .back-link-container {
        margin-bottom: 20px;
    }

    .back-link {
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
    }

    .back-link:hover {
        text-decoration: underline;
    }

    .job-details-card {
        background: white;
        border: 1px solid #576a91ff;
        background-color: rgba(232, 228, 232, 0.59);
        border-radius: 16px;
        padding: 32px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.05);
    }

    .job-details-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding-bottom: 25px;
        border-bottom: 1px solid #e5e7eb;
    }

    .job-title-section {
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .job-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 28px;
    }

    .job-icon i {
        color: color.default;
    }

    .job-title-section h1 {
        margin: 0 0 8px;
        font-size: 2rem;
    }

    .posted-info {
        color: #6b7280;
        font-size: 14px;
    }

    .posted-info strong {
        color: #111827;
    }

    .status {
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    .status.open {
        background: green;
        color: white;
    }

    .status.closed {
        background: red;
        color: white;
    }

    .job-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin: 30px 0;
        padding: 22px;
        background: #f9fafb;
        border-radius: 12px;
    }

    .summary-item {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .summary-label {
        color: #9ca3af;
        font-size: 12px;
    }

    .summary-item strong {
        color: #111827;
        font-size: 16px;
    }

    .job-section {
        margin-top: 30px;
    }

    .job-section h2 {
        margin-bottom: 12px;
        font-size: 1.25rem;
    }

    .job-section p {
        color: #4b5563;
        line-height: 1.7;
        white-space: pre-line;
    }

    .job-actions {
        margin-top: 35px;
        padding-top: 25px;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
    }

    .owner-action-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
    }

    .apply-button {
        border: none;
        background:  #2563eb;
        color: white;
        padding: 13px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 15px;
        text-decoration: none;
        display: inline-block;
    }

    .apply-button:hover {
        background: #1d4ed8;
    }

    .apply-button.secondary-action {
        background: #4b5563;
    }

    .apply-button.secondary-action:hover {
        background: #374151;
    }

    .delete-action-button {
        border: 1px solid #dc2626;
        background: white;
        color: #a92f2fff;
        padding: 13px 24px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 15px;
    }

    .delete-action-button:hover {
        background: #fee2e2;
    }

    .apply-button.disabled {
        background: #9ca3af;
        cursor: not-allowed;
    }

    .loading-container,
    .empty-state,
    .error-message {
        text-align: center;
        padding: 70px 20px;
    }

    .error-message {
        background: #fef2f2;
        border-radius: 12px;
        color: #991b1b;
    }

    .back-button {
        display: inline-block;
        margin-top: 20px;
        background:  #2563eb;
        color: white;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

    .spinner {
        width: 35px;
        height: 35px;
        border: 4px solid #e5e7eb;
        border-top-color: #2563eb;
        border-radius: 50%;
        margin: 0 auto 15px;
        animation: spin 0.8s linear infinite;
    }

    .apply-button.disabled {
        background: #f03434ff;
        cursor: not-allowed;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 700px) {

        .job-details-card {
            padding: 20px;
        }

        .job-details-header {
            flex-direction: column;
        }

        .job-summary {
            grid-template-columns: 1fr;
        }

        .job-title-section h1 {
            font-size: 1.5rem;
        }

    }

</style>

@code {

    [Parameter]
    public int Id { get; set; }

    private JobModel? job;
    private string? currentUserId;
    private bool isOwner => !string.IsNullOrEmpty(currentUserId) && job?.PostedById == currentUserId;

    private bool isLoading = true;
    private bool isActionBusy = false;

    private bool showApplicationForm;
    private bool isSubmittingApplication;
    private CreateApplicationModel application = new();
    private string? applicationError;

    private string? errorMessage;

    protected override async Task OnParametersSetAsync()
    {
        await LoadJobAsync();
    }

    private async Task LoadJobAsync()
    {
        isLoading = true;
        errorMessage = null;
        job = null;

        try
        {
            job = await JobService.GetByIdAsync(Id);

            if (job == null)
            {
                errorMessage = "The requested job could not be found.";
            }

            if (AuthService.IsLoggedIn)
            {
                var currentUser = await UserService.GetCurrentUserAsync();
                currentUserId = currentUser?.Id;
            }
        }
        catch
        {
            errorMessage = "We could not connect to the Student Job Hub API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SubmitApplicationAsync()
    {
        isSubmittingApplication = true;
        applicationError = null;

        try
        {
            var response = await ApplicationService.ApplyAsync(Id, application);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/my-applications");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                Navigation.NavigateTo($"/login?returnUrl=/jobs/{Id}");
            }
            else
            {
                applicationError = await response.Content.ReadAsStringAsync();
            }
        }
        catch (Exception ex)
        {
            applicationError = $"Unable to submit application: {ex.Message}";
        }
        finally
        {
            isSubmittingApplication = false;
        }
    }

    private async Task CloseJobAsync()
    {
        if (job is null) return;
        isActionBusy = true;
        try
        {
            var response = await JobService.CloseAsync(job.Id);
            if (response.IsSuccessStatusCode)
            {
                job.IsOpen = false;
            }
            else
            {
                errorMessage = "Unable to close this job.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error closing job: {ex.Message}";
        }
        finally
        {
            isActionBusy = false;
        }
    }

    private async Task DeleteJobAsync()
    {
        if (job is null) return;

        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Are you sure you want to delete this job posting? This action cannot be undone.");
        if (!confirmed) return;

        isActionBusy = true;
        try
        {
            var response = await JobService.DeleteAsync(job.Id);
            if (response.IsSuccessStatusCode)
            {
                Navigation.NavigateTo("/my-jobs");
            }
            else
            {
                errorMessage = "Unable to delete this job.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting job: {ex.Message}";
        }
        finally
        {
            isActionBusy = false;
        }
    }

    private void CancelApplication()
    {
        showApplicationForm = false;
        applicationError = null;
        application = new CreateApplicationModel();
    }
}