@page "/my-jobs"

@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services

@inject JobApiService JobApiService
@inject ToastService ToastService

<PageTitle>My Jobs</PageTitle>

<div class="my-jobs-page">

    <div class="my-jobs-header">

        <div>
            <h1>My Jobs</h1>

            <p>
                Manage the jobs you have posted on Student Job Hub.
            </p>
        </div>

        <a href="/post-job" class="post-job-button">
            + Post a Job
        </a>

    </div>


    @if (isLoading)
    {
        <div class="jobs-grid" style="margin-top: 20px;">
            <SkeletonCard />
            <SkeletonCard />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-card">

            <h3>Unable to load your jobs</h3>

            <p>@errorMessage</p>

            <button @onclick="LoadMyJobsAsync">
                Try Again
            </button>

        </div>
    }
    else if (jobs.Count == 0)
    {
        <div class="empty-card">

            <h2>You haven't posted any jobs yet.</h2>

            <p>
                Create your first job posting and start connecting
                with students.
            </p>

            <a href="/post-job" class="post-job-button">
                + Post Your First Job
            </a>

        </div>
    }
    else
    {
        <div class="jobs-summary">
            <strong>@jobs.Count</strong>
            @(jobs.Count == 1 ? " job" : " jobs") posted
        </div>

        <div class="jobs-grid">

            @foreach (var job in jobs)
            {
                <div class="job-card">

                    <div class="job-card-header">

                        <div>
                            <h2>@job.Title</h2>

                            <span class="job-status @(job.IsOpen ? "open" : "closed")">
                                @(job.IsOpen ? "Open" : "Closed")
                            </span>
                        </div>

                        <span class="job-budget">
                            GH₵ @job.Budget.ToString("N2")
                        </span>

                    </div>

                    <p class="job-description">
                        @job.Description
                    </p>

                    <div class="job-details">

                        <div>
                            <strong>Deadline</strong>
                            <span>
                                @job.Deadline.ToString("MMM dd, yyyy")
                            </span>
                        </div>

                        <div>
                            <strong>Posted</strong>
                            <span>
                                @job.CreatedAt.ToString("MMM dd, yyyy")
                            </span>
                        </div>

                    </div>

                    <div class="job-actions">

                        <a href="/jobs/@job.Id"
                           class="view-button">
                            View Details
                        </a>

                        <a href="/my-jobs/edit/@job.Id"
                           class="edit-button">
                            Edit
                        </a>

                        <a href="/my-jobs/@job.Id/applications"
                           class="view-button">
                            Applications
                        </a>

                        @if (job.IsOpen)
                        {
                            <button class="edit-button"
                                    @onclick="() => CloseJobAsync(job.Id)"
                                    disabled="@IsBusy(job.Id)">
                                @(IsBusy(job.Id) ? "Closing..." : "Close")
                            </button>
                        }

                        <button class="delete-button"
                                @onclick="() => DeleteJobAsync(job.Id)"
                                disabled="@IsBusy(job.Id)">
                            @(IsBusy(job.Id) ? "Working..." : "Delete")
                        </button>

                    </div>

                </div>
            }

        </div>
    }

</div>

<style>

    .job-card {
        background: rgba(232, 228, 232, 0.59);
        border: 1px solid #576a91ff;
        border-radius: 12px;
        padding: 24px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 5px;
       

        
    }
    
        

    .job-status.open {
        background: green;
        color: white;
    }
    .job-status.closed {
        background: #a92f2fff;
        color: white;
    }

    .job-actions {
        display: flex;
        flex-wrap: wrap; 
        gap: 10px; 
        align-items: center;
    }


</style>


@code {

    private List<JobModel> jobs = new();

    private bool isLoading = true;

    private string? errorMessage;
    private int? busyJobId;


    protected override async Task OnInitializedAsync()
    {
        await LoadMyJobsAsync();
    }


    private async Task LoadMyJobsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            jobs = await JobApiService.GetMyJobsAsync();
        }
        catch (Exception)
        {
            errorMessage =
                "We could not connect to the Student Job Hub API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsBusy(int jobId) => busyJobId == jobId;

    private async Task CloseJobAsync(int jobId)
    {
        busyJobId = jobId;
        errorMessage = null;

        try
        {
            var response = await JobApiService.CloseAsync(jobId);
            if (response.IsSuccessStatusCode)
            {
                var job = jobs.FirstOrDefault(item => item.Id == jobId);
                if (job != null)
                {
                    job.IsOpen = false;
                }
            }
            else
            {
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "You must be logged in to close a job."
                    : "Unable to close this job.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to close this job: {ex.Message}";
        }
        finally
        {
            busyJobId = null;
        }
    }

    private async Task DeleteJobAsync(int jobId)
    {
        busyJobId = jobId;
        errorMessage = null;

        try
        {
            var response = await JobApiService.DeleteAsync(jobId);
            if (response.IsSuccessStatusCode)
            {
                jobs.RemoveAll(item => item.Id == jobId);
            }
            else
            {
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Unauthorized
                    ? "You must be logged in to delete a job."
                    : "Unable to delete this job.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to delete this job: {ex.Message}";
        }
        finally
        {
            busyJobId = null;
        }
    }
}