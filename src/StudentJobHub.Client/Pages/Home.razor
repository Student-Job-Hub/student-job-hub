@page "/"

<PageTitle>Student Job Hub — Campus Jobs, Services & Opportunities</PageTitle>

<SeoHead Title="Student Job Hub — Campus Jobs, Services & Opportunities"
         Description="Student Job Hub connects university students with jobs, freelance services, and campus opportunities. Post jobs, apply for positions, and offer your skills."
         UrlPath="" />

<div class="home-page">
	<section class="home-hero">
		<h1>Student Job Hub</h1>
		<p>Connect students with jobs, services, and opportunities on campus.</p>
		<div class="home-actions">
			<a href="/jobs" class="secondary-button">Browse Jobs</a>
			<a href="/services" class="services-button">Explore Services</a>
		</div>
	</section>

	<section class="home-links">
		<a href="/register" class="home-link">
			<h2>Join the community</h2>
			<p>Create an account to post jobs, apply for opportunities, and offer services.</p>
		</a>

		<a href="/login" class="home-link">
			<h2>Already a member?</h2>
			<p>Sign in to manage your applications, jobs, services, and profile.</p>
		</a>
	</section>
</div>

<style>
	.home-page {
		max-width: 1100px;
		margin: 0 auto;
		padding: 48px 24px;
	}

	.home-hero {
		padding: 56px 32px;
		border-radius: 16px;
		background: #eff6ff;
		text-align: center;
	}

	.home-hero h1 {
		margin: 0 0 12px;
		font-size: 2.8rem;
	}

	.home-hero p {
		margin: 0 auto 24px;
		max-width: 620px;
		color: #4b5563;
		font-size: 1.1rem;
	}

	.home-actions {
		display: flex;
		justify-content: center;
		gap: 16px;
		
	}

	.home-links {
		display: flex;
		justify-content: center;
		gap: 16px;
	}


	.home-links {
		margin-top: 28px;
		align-items: stretch;
	}

	.home-link {
		flex: 1;
		max-width: 420px;
		padding: 24px;
		border: 1px solid #576a91ff;
		border-radius: 12px;
		color: inherit;
		text-decoration: none;
		background-color: rgba(237, 218, 237, 0.59);
	}

	.home-link:hover {
		background-color: #a9e5b9ff;
	}

	.home-link h2 {
		margin: 0 0 8px;
		font-size: 1.2rem;
	}

	.home-link p {
		margin: 0;
		color: #6b7280;
	}

	.services-button {
		background-color: #19a3edff;
		color: #0b0a0aff;
		border-radius: 0 !important;
		padding: 6px 24px;
		text-decoration: none;
		transition: all 0.2s ease;
		font-weight: bold;
	}

	@@media (max-width: 640px) {
		.home-actions,
		.home-links {
			flex-direction: column;
		}

		.home-link {
			max-width: none;
		}
	}
</style>
