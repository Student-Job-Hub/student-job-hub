        line-height: 1.7;
        font-size: 1rem;
        white-space: pre-wrap;
    }

    .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 24px 0;
        padding-top: 18px;
        border-top: 1px solid #e5e7eb;
    }

    .provider-info {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .avatar {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #2563eb;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .provider-info small {
        display: block;
        color: #9ca3af;
        font-size: 11px;
    }

    .post-date {
        color: #6b7280;
        font-size: 0.9rem;
    }

    .action-buttons-row {
        display: flex;
        gap: 12px;
        margin-top: 24px;
        flex-wrap: wrap;
    }

    .book-btn {
        background: #2563eb;
        font-size: 1rem;
        padding: 12px 24px;
    }

    .btn-outline {
        background: white;
        color: #1e293b;
        border: 1px solid #cbd5e1;
    }

    .btn-outline:hover {
        background: #f1f5f9;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.6);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        backdrop-filter: blur(4px);
    }

    .service-modal {
        background: #ffffff;
        color: #1e293b;
        padding: 24px;
        border-radius: 12px;
        width: 92%;
        max-width: 500px;
        box-shadow: 0 20px 30px rgba(0, 0, 0, 0.3);
        display: block !important;
        position: relative;
        z-index: 10000;
    }

    body.dark-mode .service-modal {
