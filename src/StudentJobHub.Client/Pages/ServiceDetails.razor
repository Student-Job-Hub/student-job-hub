@page "/services/{Id:int}"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ServiceApiService ServiceApiService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Service Details | Student Job Hub</PageTitle>




<!-- arrow back to go to previous page -->
<div class="back-button" @onclick="GoBack">
    <span class="arrow-icon">←</span>
    <span class="button-text">Back</span>
</div>

<div class="page-container">
    @if (isLoading)
    {
        <div class="loading-state">Loading service details...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <h2>Unable to load service</h2>
            <p>@errorMessage</p>
        </div>
    }
    else if (service is null)
    {
        <div class="empty-state">
            <h2>Service not found</h2>
        </div>
    }
    else
    {
        <div class="service-card">
            <h1>@service.Title</h1>
            <p class="badge">@service.Category</p>
            <p>@service.Description</p>
            <div class="meta">
                <strong>GH₵ @service.Price.ToString("N2")</strong>
                <span>Posted by @service.ProviderName</span>
            </div>
            
            <div class="contact">
                <button class="btn btn-success" @onclick="OpenContactModal">Contact Provider</button>
            </div>
        </div>
    }
</div>

<!-- Contact Provider Modal -->
@if (showContactModal)
{
    <div class="modal-overlay">
        <div class="modal">
            <div class="modal-header">
                <h2>Contact @service?.ProviderName</h2>
                <button class="modal-close" @onclick="CloseContactModal">×</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(modalErrorMessage))
                {
                    <div class="alert alert-danger">@modalErrorMessage</div>
                }

                @if (isSuccessMessageVisible)
                {
                    <div class="alert alert-success">
                        Your message has been sent to @service?.ProviderName!
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label for="contactMessage">Message</label>
                        <textarea id="contactMessage" 
                                  @bind="contactMessage" 
                                  rows="5" 
                                  class="form-control" 
                                  placeholder="Type your message to the provider..."></textarea>
                    </div>
                }
            </div>

            <div class="modal-footer">
                @if (isSuccessMessageVisible)
                {
                    <button class="btn btn-primary" @onclick="CloseContactModal">Done</button>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="CloseContactModal" disabled="@isSending">Cancel</button>
                    <button class="btn btn-success" @onclick="SendContactMessageAsync" disabled="@isSending">
                        @(isSending ? "Sending..." : "Send Message")
                    </button>
                }
            </div>
        </div>
    </div>
}

<style>
    .page-container {
        max-width: 800px;
        margin: 20px auto;
        padding: 0 20px;
    }

    .service-card {
        background: white;
        border: 1px solid #576a91ff;
        border-radius: 12px;
        padding: 24px;
       
    }

    .badge {
        display: inline-block;
        padding: 4px 12px;
        background: #e0f2fe;
        color: #0369a1;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 16px;
    }

    .meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 20px 0;
        padding-top: 16px;
        border-top: 1px solid #e5e7eb;
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

    .modal {
        background: white;
        padding: 24px;
        border-radius: 12px;
        width: 100%;
        max-width: 500px;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .modal-header h2 {
        margin: 0;
        font-size: 1.25rem;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        cursor: pointer;
        color: #6b7280;
    }

    .modal-body {
        margin-bottom: 20px;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #d1d5db;
        border-radius: 6px;
        box-sizing: border-box;
    }

    .alert {
        padding: 12px;
        border-radius: 6px;
        margin-bottom: 12px;
        font-size: 0.9rem;
    }

    .alert-danger {
        background-color: #fef2f2;
        color: #991b1b;
        border: 1px solid #576a91ff;
    }

    .alert-success {
        background-color: #f0fdf4;
        color: #166534;
        border: 1px solid #576a91ff;
    }

    .btn {
        padding: 10px 18px;
        border-radius: 6px;
        border: none;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-success { background: #16a34a; color: white; }
    .btn-secondary { background: #e5e7eb; color: #374151; }
    .btn-primary { background:  #2563eb; color: white; }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }

    .back-button {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 20px;
        cursor: pointer;
        color: #2563eb;
    }

    .back-button:hover {
        color: #4b5563;
    }

    .arrow-icon {
        font-size: 1.2rem;
    }

    .button-text {
        font-weight: 600;
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private ServiceModel? service;
    private bool isLoading = true;
    private string? errorMessage;

    private bool showContactModal = false;
    private bool isSending = false;
    private bool isSuccessMessageVisible = false;
    private string contactMessage = string.Empty;
    private string? modalErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            service = await ServiceApiService.GetByIdAsync(Id);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load service details: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenContactModal()
    {
        contactMessage = string.Empty;
        modalErrorMessage = null;
        isSuccessMessageVisible = false;
        showContactModal = true;
    }

    private void CloseContactModal()
    {
        showContactModal = false;
        contactMessage = string.Empty;
        modalErrorMessage = null;
        isSuccessMessageVisible = false;
    }

    private async Task SendContactMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(contactMessage))
        {
            modalErrorMessage = "Please enter a message before sending.";
            return;
        }

        if (service is null)
        {
            modalErrorMessage = "Service details are unavailable.";
            return;
        }

        try
        {
            isSending = true;
            modalErrorMessage = null;

            // Construct notification request with Provider ID and context details
            var request = new CreateNotificationRequest
            {
                RecipientId = service.ProviderId, // Passes Provider's ID
                Title = $"Inquiry regarding {service.Title}",
                Message = contactMessage,
                ServiceId = service.Id
            };

            // Sends to notification endpoint
            await NotificationService.CreateNotificationAsync(request);

            isSuccessMessageVisible = true;
            contactMessage = string.Empty;
            modalErrorMessage = null;

        
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"Failed to send message: {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }
      // go back to previous page
     private void GoBack()
{
    NavigationManager.NavigateTo("/services",forceLoad: false);
    
}
}