            gap: 12px;
        }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private ServiceModel? service;
    private bool isLoading = true;
    private string? errorMessage;
    private string? currentUserId;
    private bool isOwner => !string.IsNullOrEmpty(currentUserId) && service?.ProviderId == currentUserId;

    // Booking modal state
    private bool showBookingModal = false;
    private bool isSubmittingBooking = false;
    private bool isBookingSuccess = false;
    private CreateServiceBookingModel bookingModel = new();
    private string? bookingErrorMessage;

    // Contact modal state
    private bool showContactModal = false;
    private bool isSending = false;
    private bool isSuccessMessageVisible = false;
    private string contactMessage = string.Empty;
    private string? modalErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            service = await ServiceApiService.GetByIdAsync(Id);

            if (AuthService.IsLoggedIn)
            {
                var currentUser = await UserService.GetCurrentUserAsync();
                currentUserId = currentUser?.Id;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Unable to load service details: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OpenBookingModal()
    {
        if (!AuthService.IsLoggedIn)
        {
            await AuthService.InitializeAsync();
            if (!AuthService.IsLoggedIn)
            {
                NavigationManager.NavigateTo($"/login?returnUrl=/services/{Id}");
                return;
            }
        }

        bookingModel = new CreateServiceBookingModel
        {
            ServiceId = Id,
            RequestedDate = DateTime.Today.AddDays(2),
            ProposedPrice = service?.Price ?? 0,
            LocationOrDelivery = "On Campus / Library",
            Notes = string.Empty
        };
        bookingErrorMessage = null;
        isBookingSuccess = false;
        showBookingModal = true;
        StateHasChanged();
    }

    private void CloseBookingModal()
    {
        showBookingModal = false;
        bookingErrorMessage = null;
        StateHasChanged();
    }

    private async Task SubmitBookingRequestAsync()
    {
        if (string.IsNullOrWhiteSpace(bookingModel.Notes) || bookingModel.Notes.Length < 5)
        {
            bookingErrorMessage = "Please describe your project/request with at least 5 characters.";
            return;
        }

        isSubmittingBooking = true;
        bookingErrorMessage = null;

        try
        {
            var res = await BookingService.CreateBookingAsync(bookingModel);
            if (res.IsSuccessStatusCode)
            {
                isBookingSuccess = true;
                ToastService.ShowSuccess("Booking request sent to service provider!");
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                bookingErrorMessage = string.IsNullOrWhiteSpace(msg) ? "Unable to submit booking request." : msg;
            }
        }
        catch (Exception ex)
        {
            bookingErrorMessage = $"Error submitting booking: {ex.Message}";
        }
        finally
        {
            isSubmittingBooking = false;
            StateHasChanged();
        }
    }

    private void GoToMyBookings()
    {
        NavigationManager.NavigateTo("/my-bookings");
    }

    private async Task OpenContactModal()
    {
        if (!AuthService.IsLoggedIn)
        {
            await AuthService.InitializeAsync();
            if (!AuthService.IsLoggedIn)
            {
                NavigationManager.NavigateTo($"/login?returnUrl=/services/{Id}");
                return;
            }
        }

        contactMessage = string.Empty;
        modalErrorMessage = null;
        isSuccessMessageVisible = false;
        showContactModal = true;
        StateHasChanged();
    }

    private void CloseContactModal()
    {
        showContactModal = false;
        contactMessage = string.Empty;
        modalErrorMessage = null;
        isSuccessMessageVisible = false;
    }

    private async Task SendContactMessageAsync()
    {
        if (string.IsNullOrWhiteSpace(contactMessage))
        {
            modalErrorMessage = "Please enter a message before sending.";
            return;
        }

        if (service is null)
        {
            modalErrorMessage = "Service details are unavailable.";
            return;
        }

        try
        {
            isSending = true;
            modalErrorMessage = null;

            var request = new CreateNotificationRequest
            {
                RecipientId = service.ProviderId,
                Title = $"Inquiry regarding {service.Title}",
                Message = contactMessage,
                ServiceId = service.Id
            };

            await NotificationService.CreateNotificationAsync(request);

            isSuccessMessageVisible = true;
            contactMessage = string.Empty;
            modalErrorMessage = null;
            ToastService.ShowSuccess("Message sent to provider!");
        }
        catch (Exception ex)
        {
            modalErrorMessage = $"Failed to send message: {ex.Message}";
        }
        finally
        {
            isSending = false;
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/services", forceLoad: false);
    }
}