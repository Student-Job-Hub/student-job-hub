@page "/services/{Id:int}"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ServiceApiService ServiceApiService
@inject BookingApiService BookingService
@inject NotificationService NotificationService
@inject AuthService AuthService
@inject UserApiService UserService
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<PageTitle>@(service?.Title ?? "Service Details") | Student Job Hub</PageTitle>

<SeoHead Title="@(service?.Title ?? "Service Details")"
         Description="@(service != null ? $"{service.Title} — {service.Description}" : "View service details on Student Job Hub.")"
         UrlPath="@($"services/{Id}")"
         Type="article" />



<!-- arrow back to go to previous page -->
<div class="back-button" @onclick="GoBack">
    <span class="arrow-icon">←</span>
    <span class="button-text">Back to Services</span>
</div>

<div class="page-container">
    @if (isLoading)
    {
        <div class="loading-state">
            <SkeletonCard />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <h2>Unable to load service</h2>
            <p>@errorMessage</p>
        </div>
    }
    else if (service is null)
    {
        <div class="empty-state">
            <h2>Service not found</h2>
        </div>
    }
    else
    {
        <div class="service-card">
            <div style="display:flex; justify-content:space-between; align-items:flex-start; gap:16px;">
                <div>
                    <h1>@service.Title</h1>
                    <span class="badge">@service.Category</span>
                </div>
                <div class="price-header">
                    GH₵ @service.Price.ToString("N2")
                </div>
            </div>

            <div class="service-body">
                <h3>About this Service</h3>
                <p class="service-desc">@service.Description</p>
            </div>

            <div class="meta">
                <div class="provider-info">
                    <span class="avatar">
                        @(string.IsNullOrWhiteSpace(service.ProviderName) ? "P" : service.ProviderName.Substring(0, 1).ToUpper())
                    </span>
                    <div>
                        <small>Offered by</small>
                        <strong>@service.ProviderName</strong>
                    </div>
                </div>

                <span class="post-date">
                    <i class="bi bi-calendar3"></i> Posted @service.CreatedAt.ToString("MMM dd, yyyy")
                </span>
            </div>
            
            <div class="action-buttons-row">
                @if (isOwner)
                {
                    <a href="/services/edit/@service.Id" class="btn btn-primary">
                        <i class="bi bi-pencil-square"></i> Edit Service
                    </a>
                }
                else
                {
                    <button class="btn btn-primary book-btn" @onclick="OpenBookingModal">
                        <i class="bi bi-calendar-check"></i> Book / Request Service
                    </button>
                    <button class="btn btn-outline" @onclick="OpenContactModal">
                        <i class="bi bi-chat-dots"></i> Message Provider
                    </button>
                }
            </div>
        </div>
    }
</div>

<!-- Book Service Modal -->
@if (showBookingModal)
{
    <div class="modal-overlay" @onclick="CloseBookingModal">
        <div class="service-modal service-modal-lg" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Book Service: @service?.Title</h2>
                <button class="modal-close" @onclick="CloseBookingModal">×</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(bookingErrorMessage))
                {
                    <div class="alert alert-danger">@bookingErrorMessage</div>
                }

                @if (isBookingSuccess)
                {
                    <div class="alert alert-success" style="padding:20px; text-align:center;">
                        <i class="bi bi-check-circle-fill" style="font-size:2rem; color:#16a34a; display:block; margin-bottom:8px;"></i>
                        <h4>Booking Request Submitted!</h4>
                        <p style="margin:8px 0 0;">
                            Your request has been sent to <strong>@service?.ProviderName</strong>. You can track status in your bookings dashboard.
                        </p>
                    </div>
                }
                else
                {
                    <div class="booking-form-grid">
                        <div class="form-group">
                            <label for="bookingDate">Preferred Date <span class="text-danger">*</span></label>
                            <input id="bookingDate" 
                                   type="date" 
                                   class="form-control" 
                                   @bind="bookingModel.RequestedDate" />
                        </div>

                        <div class="form-group">
                            <label for="proposedPrice">Proposed Price (GH₵)</label>
                            <input id="proposedPrice" 
                                   type="number" 
                                   step="0.01" 
                                   class="form-control" 
                                   @bind="bookingModel.ProposedPrice" />
                            <small style="color:#6b7280;">Service listing price: GH₵ @service?.Price.ToString("N2")</small>
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:12px;">
                        <label for="bookingLocation">Location or Delivery Method</label>
                        <select id="bookingLocation" class="form-control" @bind="bookingModel.LocationOrDelivery">
                            <option value="On Campus / Library">On Campus (Library / Study Area)</option>
                            <option value="Remote / Online">Remote / Online</option>
                            <option value="Hostel / Hall of Residence">Hostel / Hall of Residence</option>
                            <option value="Department / Faculty Area">Department / Faculty Area</option>
                            <option value="Other / Flexible">Other (Specified in notes)</option>
                        </select>
                    </div>

                    <div class="form-group" style="margin-top:12px;">
                        <label for="bookingNotes">Project / Request Requirements <span class="text-danger">*</span></label>
                        <textarea id="bookingNotes" 
                                  @bind="bookingModel.Notes" 
                                  rows="4" 
                                  class="form-control" 
                                  placeholder="Describe specifically what you need help with, any deadlines, deliverables, or expectations..."></textarea>
                    </div>
                }
            </div>

            <div class="modal-footer">
                @if (isBookingSuccess)
                {
                    <button class="btn btn-primary" @onclick="GoToMyBookings">View My Bookings</button>
                    <button class="btn btn-secondary" @onclick="CloseBookingModal">Close</button>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="CloseBookingModal" disabled="@isSubmittingBooking">Cancel</button>
                    <button class="btn btn-primary" @onclick="SubmitBookingRequestAsync" disabled="@isSubmittingBooking">
                        @(isSubmittingBooking ? "Submitting..." : "Confirm & Send Request")
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Contact Provider Modal -->
@if (showContactModal)
{
    <div class="modal-overlay" @onclick="CloseContactModal">
        <div class="service-modal" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Contact @service?.ProviderName</h2>
                <button class="modal-close" @onclick="CloseContactModal">×</button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrEmpty(modalErrorMessage))
                {
                    <div class="alert alert-danger">@modalErrorMessage</div>
                }

                @if (isSuccessMessageVisible)
                {
                    <div class="alert alert-success">
                        Your message has been sent to @service?.ProviderName!
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label for="contactMessage">Message</label>
                        <textarea id="contactMessage" 
                                  @bind="contactMessage" 
                                  rows="5" 
                                  class="form-control" 
                                  placeholder="Type your message to the provider..."></textarea>
                    </div>
                }
            </div>

            <div class="modal-footer">
                @if (isSuccessMessageVisible)
                {
                    <button class="btn btn-primary" @onclick="CloseContactModal">Done</button>
                }
                else
                {
                    <button class="btn btn-secondary" @onclick="CloseContactModal" disabled="@isSending">Cancel</button>
                    <button class="btn btn-success" @onclick="SendContactMessageAsync" disabled="@isSending">
                        @(isSending ? "Sending..." : "Send Message")
                    </button>
                }
            </div>
        </div>
    </div>
}

<style>
