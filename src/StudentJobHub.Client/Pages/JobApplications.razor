@page "/my-jobs/{JobId:int}/applications"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject ApplicationApiService ApplicationService
@inject JobApiService JobService
@inject IJSRuntime JSRuntime

<PageTitle>Job Applications | Student Job Hub</PageTitle>

<SeoHead Title="Student Job Hub" NoIndex="true" />

<div class="page-container">
    <a href="/my-jobs" style="color: #2563eb;">Back to My Jobs</a>
    <h1>Applications</h1>

    @if (isLoading)
    {
        <div class="loading-state">Loading applications...</div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-state">
            <p>@errorMessage</p>
        </div>
    }
    else if (applications.Count == 0)
    {
        <div class="empty-state">
            <p>No applications have been submitted for this job.</p>
        </div>
    }
    else
    {
        <div class="applications-list">
            @foreach (var application in applications)
            {
                <article class="application-card">
                    <div class="application-header">
                        <div>
                            <h2>@application.ApplicantName</h2>
                            <p>Applied @application.AppliedAt.ToString("dd MMM yyyy")</p>
                        </div>
                        <span class="application-status">@application.Status</span>
                    </div>
                    <p>@application.Message</p>
                    <div class="application-actions">
                        @if (!string.IsNullOrEmpty(application.ResumeFileName))
                        {
                            <button type="button" class="resume-link" @onclick="() => DownloadResumeAsync(application)">
                                <i class="bi bi-file-earmark-pdf"></i> @application.ResumeFileName
                            </button>
                        }
                        <a class="message-link" href="/messages/@application.Id">Message applicant</a>
                        @if (IsPending(application.Status))
                        {
                            <button @onclick="() => AcceptAsync(application)" class="accept-button"
                                    disabled="@IsUpdating(application.Id)">Accept</button>
                            <button @onclick="() => RejectAsync(application)" class="reject-button"
                                    disabled="@IsUpdating(application.Id)">Decline</button>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>

@if (showStatusConfirmation)
{
    <div class="confirmation-backdrop" @onclick="CloseStatusConfirmation">
        <section class="confirmation-modal" role="dialog" aria-modal="true" aria-labelledby="confirmation-title"
                 @onclick:stopPropagation="true">
            <h2 id="confirmation-title">Application @confirmedStatus</h2>
            <p>@confirmedApplicant's application has been @confirmedStatus.ToLowerInvariant().</p>
            <button type="button" class="confirmation-close" @onclick="CloseStatusConfirmation">Done</button>
        </section>
    </div>
}

<style>
    .accept-button {
        background: green;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
    }

    .accept-button:disabled {
        background: gray;
        cursor: not-allowed;
    }

    .reject-button {
        background: red;
        color: white;
        border: none;
        padding: 8px 12px;
        border-radius: 6px;
        cursor: pointer;
    }

    .reject-button:disabled {
        background: gray;
        cursor: not-allowed;
    }

    .application-card {
        background: rgba(232, 228, 232, 0.59);
        border: 1px solid #576a91ff;
        border-radius: 12px;
        padding: 24px;
    }


    .application-actions {
        margin-top: 16px;
    }

    .message-link {
        display: inline-block;
        margin-right: 12px;
        color: #087e78;
        font-weight: 600;
    }

    .application-actions button {
        margin-right: 12px;
    }

    .application-card:not(:last-child) {
        margin-bottom: 12px;
    }

    .resume-link {
        display: inline-block;
        background: none;
        border: 0;
        padding: 0;
        cursor: pointer;
        margin-right: 12px;
        color: #dc2626;
        font-weight: 600;
        text-decoration: none;
    }

    .resume-link:hover {
        text-decoration: underline;
    }

    .application-status {
        background: #2563eb;
        color: white;
        padding: 8px 12px;
        border-radius: 6px;
        position: relative;
        bottom: 8px;
 
    }

    .confirmation-backdrop {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: grid;
        place-items: center;
        padding: 16px;
        background: rgba(15, 23, 42, 0.55);
    }

    .confirmation-modal {
        width: min(100%, 440px);
        padding: 24px;
        border-radius: 8px;
        background: white;
        color: #1f2937;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    }

    .confirmation-modal h2 {
        margin: 0 0 12px;
    }

    .confirmation-close {
        margin-top: 12px;
        padding: 8px 16px;
        border: 0;
        border-radius: 6px;
        background: #2563eb;
        color: white;
        cursor: pointer;
    }
</style>

@code {
    [Parameter] public int JobId { get; set; }

    private List<ApplicationModel> applications = new();
    private bool isLoading = true;
    private string? errorMessage;
    private int? updatingApplicationId;
    private bool showStatusConfirmation;
    private string confirmedApplicant = string.Empty;
    private string confirmedStatus = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var job = await JobService.GetByIdAsync(JobId);
            applications = await ApplicationService.GetJobApplicationsAsync(JobId);
            if (job is null)
            {
                errorMessage = "The job could not be found.";
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Unable to load applications: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsUpdating(int applicationId) => updatingApplicationId == applicationId;

    private static bool IsPending(string? status) =>
        string.Equals(status, "Pending", StringComparison.OrdinalIgnoreCase);

    private Task AcceptAsync(ApplicationModel application) =>
        UpdateStatusAsync(application, "Accepted");

    private Task RejectAsync(ApplicationModel application) =>
        UpdateStatusAsync(application, "Rejected");

    private async Task UpdateStatusAsync(ApplicationModel application, string status)
    {
        updatingApplicationId = application.Id;
        errorMessage = null;
        try
        {
            var response = await ApplicationService.UpdateStatusAsync(
                application.Id,
                new UpdateApplicationStatusModel { Status = status });

            if (response.IsSuccessStatusCode)
            {
                application.Status = status;
                confirmedApplicant = application.ApplicantName;
                confirmedStatus = status == "Rejected" ? "declined" : "accepted";
                showStatusConfirmation = true;
            }
            else
            {
                errorMessage = response.StatusCode == System.Net.HttpStatusCode.Forbidden
                    ? "You are not authorized to update this application."
                    : "Unable to update the application status.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            updatingApplicationId = null;
        }
    }

    private void CloseStatusConfirmation() => showStatusConfirmation = false;

    private async Task DownloadResumeAsync(ApplicationModel application)
    {
        try
        {
            var stream = await ApplicationService.GetResumeStreamAsync(application.Id);

            if (stream == null)
            {
                errorMessage = "The resume could not be downloaded.";
                return;
            }

            using var streamReference = new DotNetStreamReference(stream);

            await JSRuntime.InvokeVoidAsync(
                "downloadFileFromStream",
                application.ResumeFileName ?? "resume",
                streamReference);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}