@page "/jobs"
@using StudentJobHub.Client.Models
@using StudentJobHub.Client.Services
@inject JobApiService JobService
@inject BookmarkApiService BookmarkService
@inject AuthService AuthService
@inject ToastService ToastService
@inject NavigationManager Navigation

<PageTitle>Browse Student Jobs | Student Job Hub</PageTitle>

<SeoHead Title="Browse Student Jobs | Student Job Hub"
         Description="Browse and apply for student jobs posted by businesses, lecturers, and fellow students. Find part-time work, freelance gigs, and campus opportunities."
         UrlPath="jobs" />

<div class="jobs-page">

    <div class="jobs-header">
        <div>
            <h1>Find Student Jobs</h1>
            <p>
                Discover opportunities posted by businesses, lecturers,
                and other members of the Student Job Hub community.
            </p>
        </div>

        <div style="display:flex; gap:12px; align-items:center;">
            @if (AuthService.IsLoggedIn)
            {
                <a href="/saved-jobs" class="saved-jobs-link">
                    <i class="bi bi-bookmark-fill"></i> Saved Jobs (@bookmarkedJobIds.Count)
                </a>
            }
            <a href="/post-job" class="create-job-button">
                + Post a Job
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="jobs-grid" style="margin-top: 20px;">
            <SkeletonCard />
            <SkeletonCard />
            <SkeletonCard />
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-message">
            <h3>Unable to load jobs</h3>
            <p>@errorMessage</p>

            <button @onclick="LoadJobsAsync">
                Try Again
            </button>
        </div>
    }
    else if (jobs.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="bi bi-bag"></i></div>
            <h2>No jobs available</h2>
            <p>
                There are currently no jobs posted.
                Be the first to create an opportunity.
            </p>

            <a href="/post-job" class="create-job-button">
                Post a Job
            </a>
        </div>
    }
    else
    {
        <div class="jobs-toolbar">
            <span>
                <strong>@FilteredJobs.Count()</strong> job@(FilteredJobs.Count() == 1 ? "" : "s") available
            </span>

                 <div class="jobs-filter-controls">
                <input type="text" 
                      class="job-search-input"
                       placeholder="Search jobs..." 
                       @bind="searchTerm" 
                       @bind:event="oninput" 
                       style="padding: 6px 12px; border: 1px solid #d1d5db; border-radius: 6px; font-size: 0.9rem;" />

                  <select class="job-filter-select" @bind="selectedCategory">
                    <option value="All">All Categories</option>
                    @foreach (var cat in Categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>

                <select class="job-filter-select" @bind="selectedFilter">
                    <option value="All">All Jobs</option>
                    <option value="Open">Open Jobs</option>
                    <option value="Closed">Closed Jobs</option>
                </select>
            </div>
        </div>

        <div class="jobs-grid">

            @foreach (var job in FilteredJobs)
            {
                <div class="job-card">

                    <div class="job-card-header">
                        <div class="job-icon"><i class="bi bi-bag"></i></div>

                        <div style="display:flex; gap:8px; align-items:center;">
                            @if (!string.IsNullOrWhiteSpace(job.Category))
                            {
                                <span class="status" style="background: #e0f2fe; color: #0369a1; font-weight: 600;">
                                    @job.Category
                                </span>
                            }
                            @if (job.IsOpen)
                            {
                                <span class="status open">
                                    Open
                                </span>
                            }
                            else
                            {
                                <span class="status closed">
                                    Closed
                                </span>
                            }

                            <button class="bookmark-btn" 
                                    title="@(IsBookmarked(job.Id) ? "Remove Bookmark" : "Save Job")" 
                                    @onclick="() => ToggleBookmarkAsync(job.Id)"
                                    @onclick:stopPropagation="true">
                                <i class="bi @(IsBookmarked(job.Id) ? "bi-bookmark-fill text-primary" : "bi-bookmark")" style="font-size: 1.25rem;"></i>
                            </button>
                        </div>
                    </div>

                    <div class="job-content">

                        <h2>@job.Title</h2>

                        <p class="job-description">
                            @job.Description
                        </p>

                        <div class="job-info">
                            <div>
                                <span class="label">Budget</span>
                                <strong>
                                    GH₵ @job.Budget.ToString("N2")
                                </strong>
                            </div>

                            <div>
                                <span class="label">Deadline</span>
                                <strong>
                                    @job.Deadline.ToString("dd MMM yyyy")
                                </strong>
                            </div>
                            <div>
                                <span class="label">Posted</span>
                                <strong>
                                    @job.CreatedAt.ToString("dd MMM yyyy")
                                </strong>
                            </div>
                        </div>

                        <div class="requirements">
                            <span class="label">Requirements</span>
                            <p>@job.Requirements</p>
                        </div>

                        <div class="job-footer">

                            <div class="posted-by">
    @if (!string.IsNullOrWhiteSpace(job.ProfilePictureUrl))
    {
        <img src="@job.ProfilePictureUrl"
             alt="@job.PostedByName"
             class="avatar profile-avatar" />
    }
    else
    {
        <span class="avatar">
            @(string.IsNullOrWhiteSpace(job.PostedByName)
                ? "?"
                : job.PostedByName.Substring(0, 1).ToUpper())
        </span>
    }

    <div>
        <small>Posted by</small>
        <strong>@job.PostedByName</strong>
    </div>
</div>

<a href="/jobs/@job.Id" class="view-button">
    View Job
</a>

                    </div>

                </div>
                </div>
            }

        </div>
    }
</div>

<style>

    .jobs-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 24px;
    }

    .jobs-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 35px;
    }

    .jobs-header h1 {
        margin: 0 0 8px;
        font-size: 2.4rem;
        font-weight: 700;
    }

    .jobs-header p {
        margin: 0;
        color: #6b7280;
        max-width: 650px;
        line-height: 1.6;
    }

    .create-job-button {
        display: inline-block;
        background:  #2563eb;
        color: white;
        padding: 12px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        white-space: nowrap;
    }

    .create-job-button:hover {
        background: #1d4ed8;
    }

    .jobs-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .jobs-toolbar select {
        padding: 9px 12px;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        background: white;
    }

    .jobs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
        gap: 24px;
    }

    .job-card {
        background:rgba(232, 228, 232, 0.59);
        border: 0.1px solid black;
        border-radius: 14px;
        overflow: hidden;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .job-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    .job-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 20px 0;
    }

    .job-icon {
        width: 44px;
        height: 44px;
        display: flex;
        align-items: center;
        justify-content: center;
       
        border-radius: 10px;
        font-size: 22px;
    }

    .job-icon i {
        color:#2563eb;
        
    }

    .status {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status.open {
        background: green;
        color: white;
    }

    .status.closed {
        background: #a92f2fff;
        color:white;
    }

    .job-content {
        padding: 20px;
    }

    .job-content h2 {
        margin: 0 0 10px;
        font-size: 1.3rem;
    }

    .job-description {
        color: #6b7280;
        line-height: 1.5;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .job-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
        margin: 20px 0;
        padding: 15px 0;
        border-top: 1px solid #f0f0f0;
        border-bottom: 1px solid #f0f0f0;
    }

    .job-info div {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .label {
        font-size: 12px;
        color: #2e2d2dff;
    }

    .requirements {
        margin-bottom: 20px;
    }

    .requirements p {
        margin: 6px 0 0;
        color: #4b5563;
        font-size: 14px;
    }

    .job-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

    .posted-by {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .posted-by > div {
        display: flex;
        flex-direction: column;
    }

    .posted-by small {
        color: #9ca3af;
        font-size: 11px;
    }

    .posted-by strong {
        font-size: 13px;
    }

    .avatar {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #2563eb;
        color: white;
        border-radius: 50%;
        font-weight: 600;  
    }

   .profile-avatar {
    object-fit: cover;
    }

    .view-button {
        background: #111827;
        color: white;
        padding: 9px 14px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
    }

    .view-button:hover {
        background: #374151;
    }

    .loading-container,
    .empty-state,
    .error-message {
        text-align: center;
        padding: 70px 20px;
    }

    .empty-icon {
        font-size: 50px;
        margin-bottom: 15px;
    }

    .error-message {
        background: #fef2f2;
        border-radius: 12px;
        color: #991b1b;
    }

    .error-message button {
        margin-top: 10px;
        padding: 10px 18px;
        border: none;
        border-radius: 7px;
        background: #dc2626;
        color: white;
        cursor: pointer;
    }

    .spinner {
        width: 35px;
        height: 35px;
        border: 4px solid #e5e7eb;
        border-top-color: #2563eb;
        border-radius: 50%;
        margin: 0 auto 15px;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (max-width: 700px) {

        .jobs-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .jobs-grid {
            grid-template-columns: 1fr;
        }

        .jobs-toolbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 12px;
        }

    }

    .saved-jobs-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #f1f5f9;
        color: #1e293b;
        border: 1px solid #cbd5e1;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.92rem;
        transition: all 0.2s ease;
    }

    .saved-jobs-link:hover {
        background: #e2e8f0;
        color: #2563eb;
    }

    .bookmark-btn {
        background: none;
        border: none;
        cursor: pointer;
        padding: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.15s ease;
    }

    .bookmark-btn:hover {
        transform: scale(1.2);
    }

</style>

@code {

    private List<JobModel> jobs = new();
    private HashSet<int> bookmarkedJobIds = new();

    private bool isLoading = true;

    private string? errorMessage;

    private string selectedFilter = "All";
    private string selectedCategory = "All";
    private string searchTerm = string.Empty;

    private IEnumerable<string> Categories =>
        jobs.Select(j => j.Category).Where(c => !string.IsNullOrWhiteSpace(c)).Distinct().OrderBy(c => c);

    private IEnumerable<JobModel> FilteredJobs
    {
        get
        {
            var result = selectedFilter switch
            {
                "Open" => jobs.Where(j => j.IsOpen),
                "Closed" => jobs.Where(j => !j.IsOpen),
                _ => jobs.AsEnumerable()
            };

            if (selectedCategory != "All")
            {
                result = result.Where(j => j.Category == selectedCategory);
            }

            if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                var term = searchTerm.Trim().ToLowerInvariant();
                result = result.Where(j =>
                    (j.Title != null && j.Title.ToLowerInvariant().Contains(term)) ||
                    (j.Description != null && j.Description.ToLowerInvariant().Contains(term)) ||
                    (j.Category != null && j.Category.ToLowerInvariant().Contains(term)) ||
                    (j.Requirements != null && j.Requirements.ToLowerInvariant().Contains(term)) ||
                    (j.PostedByName != null && j.PostedByName.ToLowerInvariant().Contains(term))
                );
            }

            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadJobsAsync();
    }

    private async Task LoadJobsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            jobs = await JobService.GetAllAsync();

            if (AuthService.IsLoggedIn)
            {
                try
                {
                    var ids = await BookmarkService.GetBookmarkIdsAsync();
                    bookmarkedJobIds = new HashSet<int>(ids);
                }
                catch
                {
                    bookmarkedJobIds = new HashSet<int>();
                }
            }
        }
        catch
        {
            errorMessage =
                "We could not connect to the Student Job Hub API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool IsBookmarked(int jobId) => bookmarkedJobIds.Contains(jobId);

    private async Task ToggleBookmarkAsync(int jobId)
    {
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo($"/login?returnUrl=/jobs");
            return;
        }

        var isCurrentlyBookmarked = bookmarkedJobIds.Contains(jobId);

        if (isCurrentlyBookmarked)
        {
            bookmarkedJobIds.Remove(jobId);
            try
            {
                var res = await BookmarkService.RemoveBookmarkAsync(jobId);
                if (res.IsSuccessStatusCode)
                {
                    ToastService.ShowSuccess("Removed from saved jobs.");
                }
                else
                {
                    bookmarkedJobIds.Add(jobId);
                    ToastService.ShowError("Could not remove bookmark.");
                }
            }
            catch
            {
                bookmarkedJobIds.Add(jobId);
                ToastService.ShowError("Error updating bookmark.");
            }
        }
        else
        {
            bookmarkedJobIds.Add(jobId);
            try
            {
                var res = await BookmarkService.BookmarkJobAsync(jobId);
                if (res.IsSuccessStatusCode)
                {
                    ToastService.ShowSuccess("Job saved to your bookmarks!");
                }
                else
                {
                    bookmarkedJobIds.Remove(jobId);
                    ToastService.ShowError("Could not bookmark job.");
                }
            }
            catch
            {
                bookmarkedJobIds.Remove(jobId);
                ToastService.ShowError("Error bookmarking job.");
            }
        }
    }
}   
